# -----------------------------------------------------------------------------
# Cloudflare Pages / Edge CDN Caching Headers for PowerMath WebGL
# -----------------------------------------------------------------------------

# 1. Entry point & version manifests: NEVER CACHE (Always revalidate with edge)
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0
  X-Content-Type-Options: nosniff

/version.json
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0
  Access-Control-Allow-Origin: *
  Content-Type: application/json; charset=utf-8

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# 2. Immutable WebGL Build artifacts (Hashed or release-pinned builds)
/Build/*.unityweb
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/StreamingAssets/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# 3. WebGL Shell / Template assets (Short cache with stale-while-revalidate)
/TemplateData/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Access-Control-Allow-Origin: *
