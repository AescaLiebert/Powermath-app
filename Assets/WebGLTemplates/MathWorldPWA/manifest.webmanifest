{
    "name": {{{ JSON.stringify(PRODUCT_NAME) }}},
    "short_name": {{{ JSON.stringify(PRODUCT_NAME) }}},
    "start_url": "index.html",
    "display": "fullscreen",
    "background_color": "{{{ BACKGROUND_COLOR }}}",
    "theme_color": "{{{  SPLASH_SCREEN_STYLE.toLowerCase() === 'light' ? '#fff' : '#000' }}}",
    "description": {{{ JSON.stringify(PRODUCT_DESCRIPTION) }}},
    "icons": [
      {
        "src": "TemplateData/icons/mathworld-192.png",
        "sizes": "192x192",
        "type": "image/png",
        "purpose": "any"
      },
      {
        "src": "TemplateData/icons/mathworld-512.png",
        "sizes": "512x512",
        "type": "image/png",
        "purpose": "any"
      },
      {
        "src": "TemplateData/icons/mathworld-maskable-512.png",
        "sizes": "512x512",
        "type": "image/png",
        "purpose": "maskable"
      }
    ]
  }
