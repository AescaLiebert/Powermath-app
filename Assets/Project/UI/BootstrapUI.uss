.bootstrap-root {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(24, 29, 45);
}

.bootstrap-card {
    width: 560px;
    min-height: 280px;
    padding: 42px;
    align-items: stretch;
    justify-content: center;
    background-color: rgb(43, 52, 78);
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    border-bottom-right-radius: 24px;
    border-bottom-left-radius: 24px;
}

.bootstrap-title {
    margin-bottom: 24px;
    color: rgb(242, 194, 74);
    font-size: 44px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.bootstrap-status {
    margin-bottom: 14px;
    color: white;
    font-size: 24px;
    -unity-text-align: middle-center;
}

.bootstrap-progress {
    height: 28px;
    margin-bottom: 14px;
}

.bootstrap-detail {
    min-height: 48px;
    color: rgb(216, 220, 233);
    font-size: 18px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.retry-button {
    height: 52px;
    margin-top: 18px;
    color: rgb(24, 29, 45);
    background-color: rgb(242, 194, 74);
    font-size: 22px;
    -unity-font-style: bold;
}
