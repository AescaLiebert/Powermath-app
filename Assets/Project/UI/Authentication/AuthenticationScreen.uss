.auth-root {
    --auth-navy: rgb(8, 26, 71);
    --auth-gold: rgb(214, 163, 59);
    --auth-cream: rgb(255, 251, 240);
    --auth-input: rgb(255, 255, 255);
    --auth-input-border: rgb(224, 228, 234);
    --auth-placeholder: rgb(179, 179, 179);
    --auth-orange-middle: rgb(255, 158, 46);
    --auth-orange-end: rgb(255, 209, 71);
    background-color: transparent;
}

.auth-background, .auth-atmosphere, .auth-logo, .auth-border, .auth-utility, .auth-version {
    position: absolute;
}

.auth-safe-area {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
}

.auth-background {
    top: 0; right: 0; bottom: 0; left: 0;
    background-image: none;
    -unity-background-scale-mode: scale-and-crop;
}

.auth-atmosphere {
    top: 0; right: 0; bottom: 0; left: 0;
    background-color: rgba(219, 242, 255, 0.08);
}

.auth-logo {
    width: 471px; height: 170px; left: 50%; top: 20.4%;
    translate: -235.5px 0;
    background-image: url("project://database/Assets/Project/Art/math-world-logo-simple-v6.png?fileID=2800000&guid=2df4eb23f3ba311429150f7eeae77a6f&type=3#math-world-logo-simple-v6");
    -unity-background-scale-mode: scale-to-fit;
}

.auth-border {
    width: 369px; min-height: 430px; left: 50%; top: 36%;
    translate: -184.5px 0;
    padding: 5px 4.5px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.72);
    border-radius: 28px;
}

.auth-card {
    width: 360px; min-width: 360px; min-height: 420px;
    padding: 24px 28px 18px 28px;
    align-items: center;
    background-color: rgba(255, 251, 240, 0.88);
    border-width: 2px;
    border-color: rgba(237, 191, 97, 0.72);
    border-radius: 28px;
    transition-property: scale, opacity, translate;
    transition-duration: 0.26s;
    transition-timing-function: ease-out-back;
}

.auth-celestial-divider, .auth-bottom-divider {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.auth-celestial-divider { width: 180px; height: 24px; margin-bottom: 8px; }
.auth-divider-line { width: 64px; height: 1.5px; background-color: var(--auth-gold); }
.auth-divider-star { width: 42px; color: var(--auth-gold); font-size: 22px; -unity-text-align: middle-center; }

.auth-title {
    margin: 0 0 12px 0;
    color: var(--auth-navy);
    font-size: 34px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
}

.auth-input-wrapper { width: 304px; height: 40px; margin-bottom: 10px; }

.login-input.mw-field {
    width: 304px; height: 40px; min-height: 40px;
    margin: 0; padding: 0 16px;
    flex-direction: row; align-items: center;
    background-color: var(--auth-input);
    border-width: 1px;
    border-color: var(--auth-input-border);
    border-radius: 8px;
}

.login-input.mw-field:focus { border-color: var(--auth-gold); }
.login-input > .unity-text-field__label {
    width: 104px;
    min-width: 104px;
    flex-grow: 0;
    flex-shrink: 0;
    margin: 0;
    color: var(--auth-placeholder);
    font-size: 16px;
    -unity-font-style: normal;
    letter-spacing: 0;
}

#username-field > .unity-text-field__label,
#password-field > .unity-text-field__label {
    width: 104px;
    min-width: 104px;
    flex-grow: 0;
    flex-shrink: 0;
    margin: 0;
    color: var(--auth-placeholder);
    font-size: 16px;
    -unity-font-style: normal;
    letter-spacing: 0;
}

.login-input > .unity-text-field__input {
    height: 38px; min-height: 38px;
    padding: 0; margin: 0;
    background-color: rgba(255, 255, 255, 0);
    border-width: 0;
    color: var(--auth-navy);
    font-size: 16px;
}

.remember-toggle { width: 304px; margin: 1px 0 0 0; color: var(--auth-navy); font-size: 12px; }
.shared-device-warning { width: 304px; margin: 2px 0 0 0; color: rgba(8, 26, 71, 0.68); font-size: 9px; -unity-font-style: italic; white-space: normal; }

.auth-status {
    width: 304px; min-height: 22px;
    margin: 2px 0 5px 0; padding: 0;
    color: rgba(8, 26, 71, 0.74);
    background-color: rgba(255, 255, 255, 0);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

#auth-status.mw-status {
    width: 304px;
    min-height: 22px;
    margin: 2px 0 5px 0;
    padding: 0;
    color: rgba(8, 26, 71, 0.74);
    background-color: rgba(255, 255, 255, 0);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.auth-button-wrapper { width: 304px; height: 64px; }

.login-button {
    width: 304px; height: 64px; min-height: 64px;
    margin: 0;
    color: rgb(255, 255, 255);
    background-color: var(--auth-orange-middle);
    border-width: 1.5px;
    border-color: rgb(255, 230, 140);
    border-radius: 14px;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

#login-button.mw-button.mw-button--primary {
    width: 304px;
    height: 64px;
    min-height: 64px;
    margin: 0;
    color: rgb(255, 255, 255);
    background-color: var(--auth-orange-middle);
    border-width: 1.5px;
    border-color: rgb(255, 230, 140);
    border-radius: 14px;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.login-button:hover, .login-button:focus { background-color: var(--auth-orange-end); }
.auth-bottom-divider { width: 171px; height: 14px; margin-top: 10px; }
.auth-bottom-line { width: 76px; height: 1px; background-color: var(--auth-gold); }
.auth-bottom-diamond { width: 19px; color: var(--auth-gold); font-size: 12px; -unity-text-align: middle-center; }

.auth-utility {
    width: 58px; height: 58px; top: 34px; padding: 0;
    color: rgb(51, 65, 85);
    background-color: rgba(255, 247, 224, 0.94);
    border-width: 2px;
    border-color: rgb(224, 179, 102);
    border-radius: 29px;
    font-size: 28px;
    -unity-text-align: middle-center;
}

.auth-utility:hover, .auth-utility:focus { scale: 1.05 1.05; background-color: var(--auth-cream); }
.auth-language { right: 123px; }
.auth-settings { right: 43px; }
.auth-version { left: 30px; bottom: 36px; color: rgba(255, 255, 255, 0.92); font-size: 20px; -unity-font-style: bold; }

.auth-language-flyout {
    position: absolute;
    top: 100px;
    right: 88px;
    flex-direction: row;
    padding: 6px;
    background-color: rgba(255, 251, 240, 0.96);
    border-width: 2px;
    border-color: rgba(214, 163, 59, 0.75);
    border-radius: 16px;
    opacity: 0;
    scale: 0.82 0.82;
    translate: 0 -8px;
    display: none;
    transition-property: opacity, scale, translate;
    transition-duration: 0.22s;
    transition-timing-function: ease-out-back;
}

.auth-language-flyout.is-open {
    display: flex;
    opacity: 1;
    scale: 1 1;
    translate: 0 0;
}

.auth-language-btn {
    min-width: 58px;
    height: 38px;
    margin: 0 3px;
    padding: 0 10px;
    background-color: rgba(255, 255, 255, 0.92);
    border-width: 1.5px;
    border-color: rgba(224, 228, 234, 0.9);
    border-radius: 10px;
    color: var(--auth-navy);
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-property: scale, background-color, border-color;
    transition-duration: 0.15s;
}

.auth-language-btn:hover {
    background-color: rgb(255, 247, 224);
    border-color: var(--auth-gold);
    scale: 1.05 1.05;
}

.auth-language-btn.is-active {
    background-color: var(--auth-orange-middle);
    border-color: rgb(255, 230, 140);
    color: rgb(255, 255, 255);
}

@media (max-width: 900px), (max-height: 760px) {
    .auth-logo { width: 330px; height: 119px; top: 8%; translate: -165px 0; }
    .auth-border { top: 24%; scale: 0.9 0.9; }
    .auth-utility { scale: 0.85 0.85; }
}
