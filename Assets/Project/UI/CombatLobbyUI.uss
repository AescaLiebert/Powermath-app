.combat-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 125px;
    bottom: 0;
    align-items: center;
    justify-content: center;
    color: rgb(248, 248, 255);
    opacity: 1;
}

.social-modal {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(15, 22, 45, 0.82);
}

.social-modal-card {
    width: 88%;
    height: 88%;
    padding: 24px;
    border-radius: 24px;
    border-left-width: 4px;
    border-right-width: 4px;
    border-top-width: 4px;
    border-bottom-width: 4px;
    border-left-color: rgb(100, 195, 255);
    border-right-color: rgb(100, 195, 255);
    border-top-color: rgb(100, 195, 255);
    border-bottom-color: rgb(100, 195, 255);
    background-color: rgb(31, 45, 78);
    transition-property: opacity, scale, translate;
    transition-duration: 0.22s;
    transition-timing-function: ease-out-back;
}

.social-modal-header,
.leaderboard-top,
.profile-rename-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.social-title {
    color: white;
    font-size: 32px;
    -unity-font-style: bold;
}

.social-subtitle {
    color: rgb(190, 207, 235);
    font-size: 16px;
    white-space: normal;
}

.social-status {
    color: rgb(190, 207, 235);
    font-size: 14px;
    margin-top: 7px;
    white-space: normal;
}

.social-close,
.leaderboard-refresh,
.profile-name-save {
    min-width: 120px;
    height: 46px;
    color: white;
    background-color: rgb(68, 114, 184);
    -unity-font-style: bold;
    border-radius: 12px;
    transition-property: scale, translate, background-color;
    transition-duration: 0.16s;
    transition-timing-function: ease-out-back;
}

.social-close:hover,
.leaderboard-refresh:hover,
.profile-name-save:hover,
.social-close:focus,
.leaderboard-refresh:focus,
.profile-name-save:focus {
    scale: 1.04 1.04;
    translate: 0 -2px;
    background-color: rgb(85, 136, 215);
}

.social-close:active,
.leaderboard-refresh:active,
.profile-name-save:active {
    scale: 0.94 0.94;
    translate: 0 1px;
    transition-duration: 0.08s;
}

.leaderboard-top {
    margin-top: 18px;
    margin-bottom: 14px;
}

.leaderboard-throne {
    width: 42%;
    min-height: 122px;
    padding: 16px;
    color: white;
    font-size: 20px;
    -unity-font-style: bold;
    background-color: rgb(92, 59, 141);
    border-radius: 18px;
    white-space: normal;
}

.leaderboard-throne-loadout {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 9px;
}

.leaderboard-throne-loadout > Label {
    width: 31%;
    padding: 7px;
    -unity-text-align: middle-center;
    font-size: 13px;
    background-color: rgba(20, 26, 58, 0.55);
    border-radius: 8px;
    white-space: normal;
}

.leaderboard-tools {
    width: 54%;
    padding-left: 18px;
}

.leaderboard-self {
    padding: 13px;
    color: rgb(20, 69, 42);
    background-color: rgb(139, 237, 171);
    border-radius: 12px;
    -unity-font-style: bold;
    white-space: normal;
}

.leaderboard-refresh {
    margin-top: 8px;
}

.leaderboard-list {
    flex-grow: 1;
}

.leaderboard-row {
    min-height: 90px;
    margin-bottom: 10px;
    padding: 12px 16px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    color: white;
    background-color: rgb(53, 69, 105);
    border-radius: 14px;
}

.leaderboard-row > Label {
    margin-right: 14px;
    white-space: normal;
}

.leaderboard-row--diamond {
    background-color: rgb(50, 113, 152);
}

.leaderboard-row--gold {
    background-color: rgb(145, 108, 37);
}

.leaderboard-row--silver {
    background-color: rgb(105, 112, 130);
}

.leaderboard-row--self {
    border-left-width: 6px;
    border-left-color: rgb(91, 239, 137);
    background-color: rgb(39, 104, 74);
}

.profile-scroll {
    flex-grow: 1;
    margin-top: 14px;
}

.profile-summary {
    padding: 18px;
    color: white;
    font-size: 25px;
    -unity-font-style: bold;
    background-color: rgb(61, 93, 149);
    border-radius: 16px;
}

.profile-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-top: 12px;
}

.profile-stat-card {
    width: 49%;
    min-height: 155px;
    margin-bottom: 12px;
    padding: 18px;
    color: white;
    font-size: 18px;
    border-radius: 16px;
    white-space: normal;
}

.profile-stat-card--blue {
    background-color: rgb(54, 110, 172);
}

.profile-stat-card--gold {
    background-color: rgb(150, 105, 42);
}

.profile-stat-card--green {
    background-color: rgb(45, 126, 92);
}

.profile-stat-card--purple {
    background-color: rgb(105, 70, 155);
}

.profile-rename-card {
    padding: 18px;
    background-color: rgb(42, 57, 91);
    border-radius: 16px;
}

.profile-rename-title {
    color: white;
    font-size: 20px;
    -unity-font-style: bold;
}

.profile-rename-row {
    margin-top: 12px;
}

.profile-name-input {
    flex-grow: 1;
    margin-right: 12px;
}

.settlement-card {
    width: 680px;
    height: 82%;
    max-height: 760px;
    padding: 30px;
    border-left-color: rgb(179, 123, 240);
    border-right-color: rgb(179, 123, 240);
    border-top-color: rgb(179, 123, 240);
    border-bottom-color: rgb(179, 123, 240);
}

.settlement-title,
.settlement-stage,
.settlement-status {
    -unity-text-align: middle-center;
}

.settlement-stage {
    margin-top: 8px;
    color: rgb(255, 222, 126);
    font-size: 25px;
    -unity-font-style: bold;
}

.settlement-grid {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 20px;
}

.settlement-value-card {
    width: 48%;
    min-height: 150px;
    padding: 17px;
    align-items: center;
    justify-content: center;
    background-color: rgb(46, 61, 98);
    border-radius: 16px;
}

.settlement-value-title {
    color: rgb(192, 208, 235);
    font-size: 16px;
    -unity-font-style: bold;
}

.settlement-value {
    margin-top: 7px;
    color: white;
    font-size: 27px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.settlement-gain {
    margin-top: 6px;
    color: rgb(108, 239, 149);
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.settlement-result {
    margin-top: 12px;
    padding: 13px;
    color: white;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: rgba(17, 27, 54, 0.72);
    border-radius: 12px;
}

.settlement-reset-note {
    margin-top: 14px;
    padding: 14px;
    color: rgb(211, 220, 238);
    font-size: 15px;
    white-space: normal;
    background-color: rgb(42, 52, 75);
    border-radius: 12px;
}

.settlement-actions {
    flex-direction: row;
    justify-content: center;
    margin-top: 18px;
}

.settlement-actions > Button {
    margin-left: 6px;
    margin-right: 6px;
}

.player-hub-card {
    width: 780px;
    max-width: 90%;
    height: 88%;
    border-left-color: rgb(240, 169, 63);
    border-right-color: rgb(240, 169, 63);
    border-top-color: rgb(240, 169, 63);
    border-bottom-color: rgb(240, 169, 63);
}

.player-hub-scroll {
    flex-grow: 1;
    margin-top: 16px;
}

.player-stat-card,
.player-weapon-card {
    padding: 22px;
    border-radius: 18px;
}

.player-stat-card {
    align-items: center;
    background-color: rgb(44, 65, 104);
}

.player-weapon-card {
    margin-top: 16px;
    background-color: rgb(73, 57, 38);
}

.player-hub-section-title {
    color: rgb(199, 215, 240);
    font-size: 17px;
    -unity-font-style: bold;
}

.player-hub-effective-atk {
    margin-top: 7px;
    color: white;
    font-size: 44px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.player-hub-atk-breakdown {
    margin-top: 5px;
    color: white;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.player-hub-stat-bonus {
    margin-top: 8px;
    color: rgb(105, 241, 148);
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.player-hub-pet-status {
    margin-top: 9px;
    color: rgb(174, 187, 211);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.player-hub-weapon-name {
    margin-top: 9px;
    color: rgb(255, 218, 121);
    font-size: 28px;
    -unity-font-style: bold;
}

.player-hub-weapon-stat,
.player-hub-weapon-next {
    margin-top: 10px;
    padding: 13px;
    color: white;
    font-size: 17px;
    -unity-font-style: bold;
    white-space: normal;
    background-color: rgba(24, 29, 42, 0.74);
    border-radius: 11px;
}

.player-hub-weapon-next {
    color: rgb(148, 237, 177);
}

.player-hub-cost {
    margin-top: 13px;
    color: rgb(255, 210, 93);
    font-size: 20px;
    -unity-font-style: bold;
}

.player-hub-balance {
    margin-top: 6px;
    color: white;
    font-size: 17px;
}

.player-hub-upgrade {
    height: 54px;
    margin-top: 14px;
    color: white;
    background-color: rgb(187, 111, 31);
    border-radius: 14px;
    font-size: 19px;
    -unity-font-style: bold;
}

.player-hub-status {
    min-height: 24px;
    -unity-text-align: middle-center;
}

.pet-gacha-card {
    width: 820px;
    max-width: 92%;
    height: 90%;
    border-left-color: rgb(91, 208, 169);
    border-right-color: rgb(91, 208, 169);
    border-top-color: rgb(91, 208, 169);
    border-bottom-color: rgb(91, 208, 169);
}

.pet-gacha-wallet-row {
    margin-top: 15px;
    flex-direction: row;
    justify-content: space-between;
}

.pet-gacha-wallet {
    width: 32%;
    min-height: 62px;
    padding: 12px;
    color: white;
    background-color: rgb(45, 67, 103);
    border-radius: 12px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    white-space: normal;
}

.pet-gacha-wallet--projected {
    background-color: rgb(42, 101, 78);
}

.pet-gacha-catalog-status {
    margin-top: 14px;
    color: rgb(193, 224, 255);
    font-size: 18px;
    -unity-font-style: bold;
}

.pet-gacha-odds-list {
    flex-grow: 1;
    margin-top: 8px;
    padding: 10px;
    background-color: rgba(13, 22, 42, 0.65);
    border-radius: 14px;
}

.pet-gacha-rarity-header {
    margin-top: 8px;
    padding: 9px 12px;
    color: rgb(255, 223, 130);
    background-color: rgb(55, 66, 98);
    border-radius: 9px;
    -unity-font-style: bold;
}

.pet-gacha-odds-row {
    min-height: 42px;
    padding: 8px 12px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgba(177, 198, 229, 0.28);
}

.pet-gacha-pet-unowned,
.pet-gacha-pet-owned,
.pet-gacha-probability {
    color: white;
    font-size: 16px;
}

.pet-gacha-pet-owned {
    color: rgb(180, 191, 211);
}

.pet-gacha-probability {
    -unity-font-style: bold;
}

.pet-gacha-warning {
    margin-top: 10px;
    padding: 10px;
    color: rgb(255, 222, 157);
    background-color: rgb(91, 58, 40);
    border-radius: 10px;
    white-space: normal;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.pet-gacha-status {
    min-height: 24px;
    -unity-text-align: middle-center;
}

.pet-gacha-pull {
    min-width: 190px;
    height: 54px;
    margin-top: 9px;
    align-self: center;
    color: white;
    background-color: rgb(39, 139, 102);
    border-radius: 14px;
    font-size: 19px;
    -unity-font-style: bold;
}

.pet-gacha-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(5, 10, 25, 0.92);
}

.pet-gacha-confirmation-card,
.pet-gacha-result-card {
    width: 560px;
    max-width: 88%;
    padding: 28px;
    align-items: center;
    background-color: rgb(34, 50, 82);
    border-width: 3px;
    border-color: rgb(94, 204, 169);
    border-radius: 22px;
}

.pet-gacha-overlay-title {
    color: white;
    font-size: 29px;
    -unity-font-style: bold;
}

.pet-gacha-confirmation-summary {
    margin-top: 15px;
    color: rgb(221, 231, 247);
    font-size: 18px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.pet-gacha-actions {
    margin-top: 16px;
    flex-direction: row;
    justify-content: center;
}

.pet-gacha-actions > Button {
    margin-left: 7px;
    margin-right: 7px;
}

.pet-gacha-confirm {
    margin-top: 0;
}

.pet-gacha-result-card {
    transition-property: scale, opacity;
    transition-duration: 0.18s;
}

.pet-gacha-result--reveal .pet-gacha-result-card {
    scale: 1.04 1.04;
}

.pet-gacha-result--new .pet-gacha-result-card {
    border-color: rgb(255, 211, 92);
    background-color: rgb(55, 66, 105);
}

.pet-gacha-result--duplicate .pet-gacha-result-card {
    border-color: rgb(135, 154, 186);
    background-color: rgb(46, 56, 78);
}

.pet-gacha-result-rarity {
    color: rgb(255, 223, 130);
    font-size: 20px;
    -unity-font-style: bold;
}

.pet-gacha-result-icon {
    width: 190px;
    height: 190px;
    margin-top: 12px;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(12, 21, 41, 0.72);
    border-radius: 22px;
}

.pet-gacha-result-name {
    margin-top: 12px;
    color: white;
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.pet-gacha-result-state {
    margin-top: 8px;
    color: rgb(110, 241, 154);
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.pet-gacha-result--duplicate .pet-gacha-result-state {
    color: rgb(210, 219, 235);
}

.pet-gacha-result-balance {
    margin-top: 8px;
    color: rgb(255, 221, 111);
    font-size: 17px;
    -unity-font-style: bold;
}

.combat-hud {
    position: absolute;
    top: 0;
    left: 32%;
    right: 32%;
    min-height: 142px;
    padding: 10px 20px;
    background-color: rgba(12, 20, 40, 0.92);
    border-radius: 18px;
    border-width: 2px;
    border-color: rgba(107, 191, 255, 0.75);
}

.academic-rank-hud {
    margin-top: 6px;
    padding-top: 5px;
    border-top-width: 1px;
    border-top-color: rgba(107, 191, 255, 0.55);
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.academic-rank-label {
    font-size: 19px;
    -unity-font-style: bold;
    color: rgb(201, 221, 255);
}

.academic-rank-detail {
    font-size: 15px;
    color: rgb(198, 210, 231);
}

.combat-stage-label {
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 226, 129);
}

.combat-stage-progress {
    height: 18px;
    margin-top: 6px;
}

.combat-biome-row {
    margin-top: 5px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.combat-biome-label {
    color: rgb(157, 220, 255);
    font-size: 16px;
    -unity-font-style: bold;
}

.combat-map-button {
    height: 30px;
    padding-left: 12px;
    padding-right: 12px;
    color: white;
    background-color: rgb(40, 91, 139);
    border-radius: 10px;
    transition-property: scale, translate, background-color;
    transition-duration: 0.16s;
    transition-timing-function: ease-out-back;
}

.combat-map-button:hover,
.combat-map-button:focus {
    scale: 1.05 1.05;
    translate: 0 -1px;
    background-color: rgb(55, 115, 175);
}

.combat-map-button:active {
    scale: 0.95 0.95;
    translate: 0 1px;
    transition-duration: 0.08s;
}

.combat-map-modal {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background-color: rgba(5, 10, 23, 0.88);
    z-index: 120;
}

.combat-biome-transition {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 110;
    background-color: transparent;
    transition-property: opacity;
    transition-duration: 320ms;
    transition-timing-function: ease-out;
}

.combat-biome-transition-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: transparent;
}

.combat-biome-transition-card {
    align-items: center;
    justify-content: center;
    min-width: 480px;
    padding: 12px 36px;
    background-color: transparent;
    border-width: 0;
    transition-property: opacity, translate;
    transition-duration: 420ms;
    transition-timing-function: ease-out-back;
}

.combat-biome-title-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.combat-biome-ornament {
    color: white;
    font-size: 24px;
    letter-spacing: 2px;
    margin-left: 16px;
    margin-right: 16px;
    text-shadow: 0 3px 10px rgba(0, 0, 0, 0.8);
}

.combat-map-card {
    width: 78%;
    max-width: 1100px;
    padding: 28px;
    background-color: rgb(22, 37, 60);
    border-width: 3px;
    border-color: rgb(244, 190, 78);
    border-radius: 24px;
    transition-property: opacity, scale, translate;
    transition-duration: 0.22s;
    transition-timing-function: ease-out-back;
}

.combat-map-title {
    color: rgb(255, 222, 130);
    font-size: 36px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.combat-biome-transition-title {
    color: white;
    font-size: 46px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
    margin-top: 6px;
    margin-bottom: 8px;
    text-shadow: 0 4px 18px rgba(0, 0, 0, 0.85);
}

.combat-map-subtitle {
    color: rgb(195, 220, 242);
    font-size: 17px;
    -unity-text-align: middle-center;
}

.combat-biome-transition-kicker {
    color: rgb(165, 220, 255);
    display: none;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 4px;
}

.combat-biome-transition-accent {
    display: none;
}

.combat-map-route {
    margin-top: 20px;
    margin-bottom: 20px;
}

.combat-map-node {
    min-height: 50px;
    margin-top: 5px;
    padding: 10px 16px;
    color: rgb(178, 191, 211);
    background-color: rgba(12, 21, 38, 0.8);
    border-radius: 12px;
    font-size: 18px;
}

.combat-map-node--current {
    color: white;
    background-color: rgb(35, 126, 91);
    border-width: 2px;
    border-color: rgb(125, 255, 178);
}

.navigator-header {
    min-height: 75px;
    padding-bottom: 12px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.combat-map-title.navigator-title {
    -unity-text-align: middle-left;
}

.combat-map-subtitle.navigator-subtitle {
    -unity-text-align: middle-left;
}

.navigator-header-controls {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

.navigator-balance-pill {
    min-width: 130px;
    height: 54px;
    padding: 7px 18px 7px 14px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgb(255, 249, 232);
    border-radius: 27px;
    border-width: 3px;
    border-color: rgb(222, 199, 157);
}

.navigator-coin-icon {
    width: 34px;
    height: 34px;
    margin-right: 10px;
    background-image: url("project://database/Assets/Project/Art/UI/Icon/coin_power.png?fileID=-6225944553927798696&guid=0293b2c42305b784eb70f1ca658d2b92&type=3#coin_power_1");
    -unity-background-scale-mode: scale-to-fit;
}

.navigator-balance {
    color: rgb(20, 48, 91);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.combat-map-close,
.navigator-close {
    display: flex;
    min-width: 54px;
    width: 54px;
    min-height: 54px;
    height: 54px;
    margin-left: 14px;
    padding: 0;
    color: rgb(20, 48, 91);
    background-color: rgb(255, 249, 232);
    border-radius: 15px;
    border-width: 3px;
    border-color: rgb(222, 199, 157);
    font-size: 34px;
    -unity-font-style: bold;
    transition-property: scale, translate, background-color, border-color;
    transition-duration: 0.16s;
    transition-timing-function: ease-out-back;
}

.combat-map-close:hover,
.combat-map-close:focus,
.navigator-close:hover,
.navigator-close:focus {
    scale: 1.06 1.06;
    translate: 0 -2px;
    border-color: rgb(255, 194, 64);
    background-color: white;
}

.combat-map-close:active,
.navigator-close:active {
    scale: 0.94 0.94;
    translate: 0 1px;
    transition-duration: 0.08s;
}

.combat-enemy-card {
    position: absolute;
    width: 440px;
    height: 520px;
    top: 100px;
    align-items: center;
    padding: 18px;
    background-color: rgba(14, 19, 32, 0.86);
    border-radius: 28px;
    border-width: 3px;
    border-color: rgba(255, 180, 74, 0.82);
    transition-property: translate, scale, background-color;
    transition-duration: 0.18s;
    transition-timing-function: ease-out-back;
}

.combat-enemy--hit {
    translate: -10px 0;
    background-color: rgba(175, 54, 38, 0.9);
}

.combat-enemy--critical {
    translate: -18px 0;
    scale: 1.035 1.035;
    background-color: rgba(231, 110, 24, 0.94);
}

.combat-enemy-name {
    font-size: 31px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 226, 167);
}

.combat-enemy-image {
    width: 330px;
    height: 330px;
    margin-top: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.combat-enemy-hp {
    width: 100%;
    height: 25px;
    margin-top: 4px;
}

.combat-enemy-hp-label,
.combat-cooldown,
.combat-hearts {
    font-size: 19px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 5px;
}

.combat-cooldown--danger,
.combat-timer--danger {
    color: rgb(255, 97, 97);
    scale: 1.08 1.08;
}

.combat-hearts {
    color: rgb(255, 105, 128);
}

.combat-attack-button {
    position: absolute;
    right: 7%;
    bottom: 12%;
    width: 220px;
    height: 86px;
    font-size: 30px;
    -unity-font-style: bold;
    color: white;
    background-color: rgb(35, 91, 177);
    border-radius: 22px;
    border-width: 3px;
    border-color: rgb(255, 210, 92);
    transition-property: scale, translate, background-color, border-color;
    transition-duration: 0.16s;
    transition-timing-function: ease-out-back;
}

.combat-attack-button:hover,
.combat-attack-button:focus {
    scale: 1.06 1.06;
    translate: 0 -3px;
    background-color: rgb(48, 115, 215);
    border-color: rgb(255, 226, 112);
}

.combat-attack-button:active {
    scale: 0.93 0.93;
    translate: 0 2px;
    transition-duration: 0.08s;
}

.combat-attempt-panel {
    position: absolute;
    width: 460px;
    max-width: 90%;
    margin-left: auto;
    margin-right: auto;
    top: 40px;
    bottom: 40px;
    padding: 20px 24px;
    background-color: var(--color-surface-card, rgb(255, 255, 255));
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    border-bottom-left-radius: 24px;
    border-bottom-right-radius: 24px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--color-border-card, rgb(191, 215, 234));
    border-right-color: var(--color-border-card, rgb(191, 215, 234));
    border-top-color: var(--color-border-card, rgb(191, 215, 234));
    border-bottom-color: var(--color-border-card, rgb(191, 215, 234));
    align-items: stretch;
    justify-content: space-between;
}

.combat-attempt-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.combat-attempt-star {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--color-border-blue, rgb(147, 187, 220));
}

.combat-attempt-title {
    font-size: 15px;
    color: var(--color-navy, rgb(11, 37, 69));
    -unity-font-style: bold;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
}

.combat-answer-content {
    flex-grow: 1;
    flex-direction: column;
    justify-content: space-between;
    align-items: stretch;
}

.academic-question-meta {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--color-slate-muted, rgb(100, 116, 139));
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.equation-row {
    justify-content: center;
    align-items: center;
    margin-bottom: 6px;
}

.academic-question-prompt {
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--color-navy, rgb(11, 37, 69));
    -unity-text-align: middle-center;
    white-space: normal;
}

.combat-timer-widget {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-bottom: 8px;
}

.combat-timer {
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--color-navy, rgb(11, 37, 69));
    margin-right: 6px;
    transition-property: scale, color;
    transition-duration: 0.15s;
}

.combat-timer--danger {
    color: var(--color-failure-red, rgb(239, 68, 68));
    scale: 1.1 1.1;
}

.combat-timer-caption {
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    color: var(--color-slate-muted, rgb(100, 116, 139));
}

.answer-display-box {
    height: 52px;
    background-color: var(--color-surface-input, rgb(244, 248, 253));
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--color-border-input, rgb(133, 182, 222));
    border-right-color: var(--color-border-input, rgb(133, 182, 222));
    border-top-color: var(--color-border-input, rgb(133, 182, 222));
    border-bottom-color: var(--color-border-input, rgb(133, 182, 222));
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-left: 16px;
    padding-right: 16px;
    margin-bottom: 12px;
    transition-property: border-left-color, border-right-color, border-top-color, border-bottom-color, background-color;
    transition-duration: 0.15s;
}

.bracket-star {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--color-border-input, rgb(133, 182, 222));
}

.combat-answer-display {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--color-navy, rgb(11, 37, 69));
    -unity-text-align: middle-center;
    background-color: transparent;
    border-width: 0;
    margin: 0;
    padding: 0;
}

.combat-answer--placeholder {
    color: var(--color-slate-muted, rgb(100, 116, 139));
    font-size: 16px;
    -unity-font-style: normal;
}

.combat-numpad {
    align-items: stretch;
    margin-bottom: 12px;
}

.keypad-row {
    flex-direction: row;
    align-items: stretch;
    margin-bottom: 8px;
}

.combat-key {
    flex-grow: 1;
    height: 50px;
    margin-left: 4px;
    margin-right: 4px;
    background-color: var(--color-surface-key, rgb(240, 245, 250));
    border-left-width: 1.5px;
    border-right-width: 1.5px;
    border-top-width: 1.5px;
    border-bottom-width: 1.5px;
    border-left-color: var(--color-surface-key-border, rgb(212, 226, 238));
    border-right-color: var(--color-surface-key-border, rgb(212, 226, 238));
    border-top-color: var(--color-surface-key-border, rgb(212, 226, 238));
    border-bottom-color: var(--color-surface-key-border, rgb(212, 226, 238));
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    justify-content: center;
    align-items: center;
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--color-navy, rgb(11, 37, 69));
    -unity-text-align: middle-center;
    transition-property: scale, background-color, border-left-color, border-right-color, border-top-color, border-bottom-color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.combat-key:hover,
.combat-key:focus {
    scale: 1.04 1.04;
    background-color: rgb(232, 242, 252);
    border-left-color: var(--color-border-input, rgb(133, 182, 222));
    border-right-color: var(--color-border-input, rgb(133, 182, 222));
    border-top-color: var(--color-border-input, rgb(133, 182, 222));
    border-bottom-color: var(--color-border-input, rgb(133, 182, 222));
}

.combat-key:active {
    scale: 0.94 0.94;
    background-color: rgb(218, 233, 248);
}

.combat-key--utility {
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
}

.combat-submit-button {
    height: 54px;
    background-color: var(--color-btn-orange-bottom, rgb(242, 78, 46));
    border-left-width: 1.5px;
    border-right-width: 1.5px;
    border-top-width: 1.5px;
    border-bottom-width: 1.5px;
    border-left-color: var(--color-btn-orange-border, rgb(224, 62, 32));
    border-right-color: var(--color-btn-orange-border, rgb(224, 62, 32));
    border-top-color: var(--color-btn-orange-border, rgb(224, 62, 32));
    border-bottom-color: var(--color-btn-orange-border, rgb(224, 62, 32));
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
    justify-content: center;
    align-items: center;
    font-size: 16px;
    -unity-font-style: bold;
    color: white;
    letter-spacing: 1.5px;
    -unity-text-align: middle-center;
    transition-property: scale, translate, background-color;
    transition-duration: 0.16s;
    transition-timing-function: ease-out-back;
}

.combat-submit-button:hover,
.combat-submit-button:focus {
    scale: 1.03 1.03;
    translate: 0 -2px;
    background-color: var(--color-btn-orange-top, rgb(255, 133, 51));
}

.combat-submit-button:active {
    scale: 0.95 0.95;
    translate: 0 2px;
    transition-duration: 0.08s;
}

.combat-feedback-card {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--color-surface-card, rgb(255, 255, 255));
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    border-bottom-left-radius: 24px;
    border-bottom-right-radius: 24px;
    padding: 24px 20px;
    flex-direction: column;
    align-items: center;
    justify-content: space-around;
}

.combat-feedback-card .combat-feedback-icon {
    position: absolute;
    right: -42px;
    top: 12px;
    width: 74px;
    height: 74px;
    border-radius: 37px;
    background-color: rgb(59, 179, 119);
    color: white;
    font-size: 45px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    rotate: 5deg;
}

.combat-feedback-card--negative .combat-feedback-icon {
    background-color: rgb(219, 75, 83);
    rotate: -5deg;
}

.combat-result-sticker {
    position: absolute;
    top: -60px;
    right: 192px;
    width: 512px;
    height: 512px;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: scale, opacity;
    transition-duration: 0.22s;
    transition-timing-function: ease-out-back;
    scale: 1 1;
    opacity: 1;
}

.combat-result-sticker.is-hidden {
    display: none;
    opacity: 0;
    scale: 0.5 0.5;
}

.combat-feedback-banner {
    background-color: var(--color-correct-green, rgb(34, 197, 94));
    border-radius: 12px;
    padding: 8px 24px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.combat-feedback-card--negative .combat-feedback-banner {
    background-color: var(--color-failure-red, rgb(239, 68, 68));
}

.combat-feedback-icon {
    font-size: 18px;
    -unity-font-style: bold;
    color: white;
    margin-right: 8px;
}

.combat-feedback-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: white;
    letter-spacing: 1.5px;
    -unity-text-align: middle-center;
}

.combat-feedback-subtitle {
    font-size: 14px;
    color: var(--color-navy, rgb(11, 37, 69));
    -unity-text-align: middle-center;
    margin-top: 8px;
    margin-bottom: 8px;
}

.combat-score-stack {
    width: 100%;
    align-items: center;
    justify-content: center;
    margin-top: 10px;
    margin-bottom: 10px;
}

.combat-score-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 80%;
    padding: 8px 14px;
    background-color: var(--color-surface-input, rgb(244, 248, 253));
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--color-border-input, rgb(133, 182, 222));
    margin-bottom: 4px;
}

.combat-score-row--final {
    background-color: var(--color-buff-blue-bg, rgb(224, 242, 254));
    border-color: var(--color-buff-blue-icon, rgb(2, 132, 199));
}

.combat-score-label {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--color-navy, rgb(11, 37, 69));
}

.combat-score-value {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--color-buff-blue-icon, rgb(2, 132, 199));
}

.combat-score-connector {
    font-size: 10px;
    color: var(--color-border-input, rgb(133, 182, 222));
    margin-top: 2px;
    margin-bottom: 2px;
}

.combat-result {
    min-height: 24px;
    margin-top: 4px;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.combat-result--positive {
    color: var(--color-correct-green, rgb(34, 197, 94));
}

.combat-result--negative {
    color: var(--color-failure-red, rgb(239, 68, 68));
}

.academic-currency-gain {
    display: none;
    min-height: 24px;
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--color-btn-orange-top, rgb(255, 133, 51));
    -unity-text-align: middle-center;
}

.academic-rank-modal {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: -125px;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(3, 7, 18, 0.88);
    transition-property: opacity;
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
}

.academic-rank-aura {
    position: absolute;
    width: 620px;
    height: 620px;
    border-radius: 310px;
    background-color: rgba(255, 198, 65, 0.18);
    opacity: 0;
    scale: 0.4 0.4;
    transition-property: opacity, scale;
    transition-duration: 0.4s;
    transition-timing-function: ease-out-back;
}

.academic-rank-modal--promotion .academic-rank-aura {
    background-color: rgba(255, 204, 77, 0.24);
}

.academic-rank-modal--adjustment .academic-rank-aura {
    background-color: rgba(105, 223, 242, 0.2);
}

.academic-rank-modal--entering .academic-rank-aura,
.academic-rank-modal--revealed .academic-rank-aura {
    opacity: 1;
    scale: 1 1;
}

.academic-rank-notification {
    align-items: center;
    justify-content: center;
    scale: 0.35 0.35;
    opacity: 0;
    translate: 0 20px;
    transition-property: scale, opacity, translate;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-back;
}

.academic-rank-modal--entering .academic-rank-notification,
.academic-rank-modal--revealed .academic-rank-notification {
    scale: 1 1;
    opacity: 1;
    translate: 0 0;
}

.academic-rank-banner {
    min-width: 520px;
    height: 96px;
    padding: 12px 42px;
    align-items: center;
    justify-content: center;
    border-radius: 28px;
    border-width: 4px;
    border-color: rgb(255, 215, 80);
    background-color: rgb(32, 40, 68);
    overflow: hidden;
}

.academic-rank-modal--promotion .academic-rank-banner {
    border-color: rgb(255, 215, 80);
    background-color: rgb(38, 44, 76);
}

.academic-rank-modal--adjustment .academic-rank-banner {
    border-color: rgb(130, 190, 245);
    background-color: rgb(24, 36, 56);
}

.academic-rank-modal-header {
    font-size: 44px;
    -unity-font-style: bold;
    color: rgb(255, 225, 100);
    -unity-text-align: middle-center;
    letter-spacing: 2px;
}

.academic-rank-modal--adjustment .academic-rank-modal-header {
    color: rgb(200, 230, 255);
}

.academic-rank-route-container {
    margin-top: 28px;
    align-items: center;
    justify-content: center;
    opacity: 0;
    translate: 0 16px;
    transition-property: opacity, translate;
    transition-duration: 0.28s;
    transition-timing-function: ease-out-back;
}

.academic-rank-route-container.academic-rank-route--revealed {
    opacity: 1;
    translate: 0 0;
}

.academic-rank-route-badges {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.academic-rank-badge {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-width: 170px;
    height: 64px;
    padding: 8px 24px;
    border-radius: 20px;
    border-width: 3px;
    border-color: rgb(194, 208, 226);
    background-color: rgba(18, 30, 56, 0.95);
}

.academic-rank-badge--silver {
    border-color: rgb(194, 208, 226);
}

.academic-rank-badge--gold {
    border-color: rgb(255, 198, 65);
}

.academic-rank-badge--diamond {
    border-color: rgb(105, 223, 242);
}

.academic-rank-badge-icon {
    width: 38px;
    height: 38px;
    border-radius: 19px;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-right: 12px;
}

.academic-rank-badge-name {
    font-size: 24px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-center;
}

.academic-rank-arrow {
    margin: 0 24px;
    font-size: 38px;
    -unity-font-style: bold;
    color: rgb(255, 224, 112);
    -unity-text-align: middle-center;
}

.academic-rank-modal--adjustment .academic-rank-arrow {
    color: rgb(150, 210, 255);
}

.academic-rank-tap-prompt {
    margin-top: 24px;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgba(210, 230, 255, 0.75);
    -unity-text-align: middle-center;
    letter-spacing: 1px;
}

.academic-rank-touch-surface {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.001);
    border-width: 0;
    border-radius: 0;
    margin: 0;
    padding: 0;
}

.academic-rank-modal--dismissing .academic-rank-route-container {
    opacity: 0;
    translate: 0 10px;
    transition-duration: 0.12s;
    transition-timing-function: ease-in;
}

.academic-rank-modal--dismissing .academic-rank-notification {
    opacity: 0;
    translate: 0 -90px;
    scale: 0.95 0.95;
    transition-property: opacity, translate, scale;
    transition-duration: 0.24s;
    transition-timing-function: ease-in-back;
}

.academic-rank-modal--dismissing .academic-rank-aura {
    opacity: 0;
    scale: 0.6 0.6;
    transition-duration: 0.2s;
}

.combat-damage-label {
    position: absolute;
    top: 230px;
    font-size: 82px;
    -unity-font-style: bold;
    color: rgb(255, 237, 99);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(89, 16, 5);
    opacity: 0;
    scale: 0.55 0.55;
    translate: 0 35px;
    transition-property: opacity, scale, translate;
    transition-duration: 0.26s;
    transition-timing-function: ease-out-back;
}

.combat-damage--animate {
    opacity: 1;
    scale: 1.28 1.28;
    translate: 0 -24px;
}

.combat-critical-label {
    position: absolute;
    top: 205px;
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(255, 137, 35);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(65, 11, 4);
}
