.combat-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 125px;
    bottom: 0;
    align-items: center;
    justify-content: center;
    color: rgb(248, 248, 255);
    opacity: 1;
}

.social-modal {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(15, 22, 45, 0.82);
}

.social-modal-card {
    width: 88%;
    height: 88%;
    padding: 24px;
    border-radius: 24px;
    border-left-width: 4px;
    border-right-width: 4px;
    border-top-width: 4px;
    border-bottom-width: 4px;
    border-left-color: rgb(100, 195, 255);
    border-right-color: rgb(100, 195, 255);
    border-top-color: rgb(100, 195, 255);
    border-bottom-color: rgb(100, 195, 255);
    background-color: rgb(31, 45, 78);
}

.social-modal-header,
.leaderboard-top,
.profile-rename-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.social-title {
    color: white;
    font-size: 32px;
    -unity-font-style: bold;
}

.social-subtitle {
    color: rgb(190, 207, 235);
    font-size: 16px;
    white-space: normal;
}

.social-status {
    color: rgb(190, 207, 235);
    font-size: 14px;
    margin-top: 7px;
    white-space: normal;
}

.social-close,
.leaderboard-refresh,
.profile-name-save {
    min-width: 120px;
    height: 46px;
    color: white;
    background-color: rgb(68, 114, 184);
    -unity-font-style: bold;
}

.leaderboard-top {
    margin-top: 18px;
    margin-bottom: 14px;
}

.leaderboard-throne {
    width: 42%;
    min-height: 122px;
    padding: 16px;
    color: white;
    font-size: 20px;
    -unity-font-style: bold;
    background-color: rgb(92, 59, 141);
    border-radius: 18px;
    white-space: normal;
}

.leaderboard-throne-loadout {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 9px;
}

.leaderboard-throne-loadout > Label {
    width: 31%;
    padding: 7px;
    -unity-text-align: middle-center;
    font-size: 13px;
    background-color: rgba(20, 26, 58, 0.55);
    border-radius: 8px;
    white-space: normal;
}

.leaderboard-tools {
    width: 54%;
    padding-left: 18px;
}

.leaderboard-self {
    padding: 13px;
    color: rgb(20, 69, 42);
    background-color: rgb(139, 237, 171);
    border-radius: 12px;
    -unity-font-style: bold;
    white-space: normal;
}

.leaderboard-refresh {
    margin-top: 8px;
}

.leaderboard-list {
    flex-grow: 1;
}

.leaderboard-row {
    min-height: 90px;
    margin-bottom: 10px;
    padding: 12px 16px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    color: white;
    background-color: rgb(53, 69, 105);
    border-radius: 14px;
}

.leaderboard-row > Label {
    margin-right: 14px;
    white-space: normal;
}

.leaderboard-row--diamond {
    background-color: rgb(50, 113, 152);
}

.leaderboard-row--gold {
    background-color: rgb(145, 108, 37);
}

.leaderboard-row--silver {
    background-color: rgb(105, 112, 130);
}

.leaderboard-row--self {
    border-left-width: 6px;
    border-left-color: rgb(91, 239, 137);
    background-color: rgb(39, 104, 74);
}

.profile-scroll {
    flex-grow: 1;
    margin-top: 14px;
}

.profile-summary {
    padding: 18px;
    color: white;
    font-size: 25px;
    -unity-font-style: bold;
    background-color: rgb(61, 93, 149);
    border-radius: 16px;
}

.profile-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-top: 12px;
}

.profile-stat-card {
    width: 49%;
    min-height: 155px;
    margin-bottom: 12px;
    padding: 18px;
    color: white;
    font-size: 18px;
    border-radius: 16px;
    white-space: normal;
}

.profile-stat-card--blue {
    background-color: rgb(54, 110, 172);
}

.profile-stat-card--gold {
    background-color: rgb(150, 105, 42);
}

.profile-stat-card--green {
    background-color: rgb(45, 126, 92);
}

.profile-stat-card--purple {
    background-color: rgb(105, 70, 155);
}

.profile-rename-card {
    padding: 18px;
    background-color: rgb(42, 57, 91);
    border-radius: 16px;
}

.profile-rename-title {
    color: white;
    font-size: 20px;
    -unity-font-style: bold;
}

.profile-rename-row {
    margin-top: 12px;
}

.profile-name-input {
    flex-grow: 1;
    margin-right: 12px;
}

.settlement-card {
    width: 680px;
    height: 82%;
    max-height: 760px;
    padding: 30px;
    border-left-color: rgb(179, 123, 240);
    border-right-color: rgb(179, 123, 240);
    border-top-color: rgb(179, 123, 240);
    border-bottom-color: rgb(179, 123, 240);
}

.settlement-title,
.settlement-stage,
.settlement-status {
    -unity-text-align: middle-center;
}

.settlement-stage {
    margin-top: 8px;
    color: rgb(255, 222, 126);
    font-size: 25px;
    -unity-font-style: bold;
}

.settlement-grid {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 20px;
}

.settlement-value-card {
    width: 48%;
    min-height: 150px;
    padding: 17px;
    align-items: center;
    justify-content: center;
    background-color: rgb(46, 61, 98);
    border-radius: 16px;
}

.settlement-value-title {
    color: rgb(192, 208, 235);
    font-size: 16px;
    -unity-font-style: bold;
}

.settlement-value {
    margin-top: 7px;
    color: white;
    font-size: 27px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.settlement-gain {
    margin-top: 6px;
    color: rgb(108, 239, 149);
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.settlement-result {
    margin-top: 12px;
    padding: 13px;
    color: white;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: rgba(17, 27, 54, 0.72);
    border-radius: 12px;
}

.settlement-reset-note {
    margin-top: 14px;
    padding: 14px;
    color: rgb(211, 220, 238);
    font-size: 15px;
    white-space: normal;
    background-color: rgb(42, 52, 75);
    border-radius: 12px;
}

.settlement-actions {
    flex-direction: row;
    justify-content: center;
    margin-top: 18px;
}

.settlement-actions > Button {
    margin-left: 6px;
    margin-right: 6px;
}

.player-hub-card {
    width: 780px;
    max-width: 90%;
    height: 88%;
    border-left-color: rgb(240, 169, 63);
    border-right-color: rgb(240, 169, 63);
    border-top-color: rgb(240, 169, 63);
    border-bottom-color: rgb(240, 169, 63);
}

.player-hub-scroll {
    flex-grow: 1;
    margin-top: 16px;
}

.player-stat-card,
.player-weapon-card {
    padding: 22px;
    border-radius: 18px;
}

.player-stat-card {
    align-items: center;
    background-color: rgb(44, 65, 104);
}

.player-weapon-card {
    margin-top: 16px;
    background-color: rgb(73, 57, 38);
}

.player-hub-section-title {
    color: rgb(199, 215, 240);
    font-size: 17px;
    -unity-font-style: bold;
}

.player-hub-effective-atk {
    margin-top: 7px;
    color: white;
    font-size: 44px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.player-hub-atk-breakdown {
    margin-top: 5px;
    color: white;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.player-hub-stat-bonus {
    margin-top: 8px;
    color: rgb(105, 241, 148);
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.player-hub-pet-status {
    margin-top: 9px;
    color: rgb(174, 187, 211);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.player-hub-weapon-name {
    margin-top: 9px;
    color: rgb(255, 218, 121);
    font-size: 28px;
    -unity-font-style: bold;
}

.player-hub-weapon-stat,
.player-hub-weapon-next {
    margin-top: 10px;
    padding: 13px;
    color: white;
    font-size: 17px;
    -unity-font-style: bold;
    white-space: normal;
    background-color: rgba(24, 29, 42, 0.74);
    border-radius: 11px;
}

.player-hub-weapon-next {
    color: rgb(148, 237, 177);
}

.player-hub-cost {
    margin-top: 13px;
    color: rgb(255, 210, 93);
    font-size: 20px;
    -unity-font-style: bold;
}

.player-hub-balance {
    margin-top: 6px;
    color: white;
    font-size: 17px;
}

.player-hub-upgrade {
    height: 54px;
    margin-top: 14px;
    color: white;
    background-color: rgb(187, 111, 31);
    border-radius: 14px;
    font-size: 19px;
    -unity-font-style: bold;
}

.player-hub-status {
    min-height: 24px;
    -unity-text-align: middle-center;
}

.combat-hud {
    position: absolute;
    top: 0;
    left: 32%;
    right: 32%;
    min-height: 142px;
    padding: 10px 20px;
    background-color: rgba(12, 20, 40, 0.92);
    border-radius: 18px;
    border-width: 2px;
    border-color: rgba(107, 191, 255, 0.75);
}

.academic-rank-hud {
    margin-top: 6px;
    padding-top: 5px;
    border-top-width: 1px;
    border-top-color: rgba(107, 191, 255, 0.55);
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.academic-rank-label {
    font-size: 19px;
    -unity-font-style: bold;
    color: rgb(201, 221, 255);
}

.academic-rank-detail {
    font-size: 15px;
    color: rgb(198, 210, 231);
}

.combat-stage-label {
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 226, 129);
}

.combat-stage-progress {
    height: 18px;
    margin-top: 6px;
}

.combat-biome-row {
    margin-top: 5px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.combat-biome-label {
    color: rgb(157, 220, 255);
    font-size: 16px;
    -unity-font-style: bold;
}

.combat-map-button {
    height: 30px;
    padding-left: 12px;
    padding-right: 12px;
    color: white;
    background-color: rgb(40, 91, 139);
    border-radius: 10px;
}

.combat-map-modal,
.combat-biome-transition {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background-color: rgba(5, 10, 23, 0.88);
}

.combat-map-modal { z-index: 120; }
.combat-biome-transition { z-index: 110; }

.combat-map-card {
    width: 78%;
    max-width: 1100px;
    padding: 28px;
    background-color: rgb(22, 37, 60);
    border-width: 3px;
    border-color: rgb(244, 190, 78);
    border-radius: 24px;
}

.combat-map-title,
.combat-biome-transition-title {
    color: rgb(255, 222, 130);
    font-size: 36px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.combat-map-subtitle,
.combat-biome-transition-kicker {
    color: rgb(195, 220, 242);
    font-size: 17px;
    -unity-text-align: middle-center;
}

.combat-map-route { margin-top: 20px; margin-bottom: 20px; }

.combat-map-node {
    min-height: 50px;
    margin-top: 5px;
    padding: 10px 16px;
    color: rgb(178, 191, 211);
    background-color: rgba(12, 21, 38, 0.8);
    border-radius: 12px;
    font-size: 18px;
}

.combat-map-node--current {
    color: white;
    background-color: rgb(35, 126, 91);
    border-width: 2px;
    border-color: rgb(125, 255, 178);
}

.combat-map-close {
    height: 48px;
    color: white;
    background-color: rgb(45, 99, 166);
    border-radius: 14px;
    font-size: 18px;
    -unity-font-style: bold;
}

.combat-enemy-card {
    position: absolute;
    width: 440px;
    height: 520px;
    top: 100px;
    align-items: center;
    padding: 18px;
    background-color: rgba(14, 19, 32, 0.86);
    border-radius: 28px;
    border-width: 3px;
    border-color: rgba(255, 180, 74, 0.82);
    transition-property: translate, scale, background-color;
    transition-duration: 0.16s;
}

.combat-enemy--hit {
    translate: -10px 0;
    background-color: rgba(175, 54, 38, 0.9);
}

.combat-enemy--critical {
    translate: -18px 0;
    scale: 1.035 1.035;
    background-color: rgba(231, 110, 24, 0.94);
}

.combat-enemy-name {
    font-size: 31px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 226, 167);
}

.combat-enemy-image {
    width: 330px;
    height: 330px;
    margin-top: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.combat-enemy-hp {
    width: 100%;
    height: 25px;
    margin-top: 4px;
}

.combat-enemy-hp-label,
.combat-cooldown,
.combat-hearts {
    font-size: 19px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 5px;
}

.combat-cooldown--danger,
.combat-timer--danger {
    color: rgb(255, 97, 97);
    scale: 1.08 1.08;
}

.combat-hearts {
    color: rgb(255, 105, 128);
}

.combat-attack-button {
    position: absolute;
    right: 7%;
    bottom: 12%;
    width: 220px;
    height: 86px;
    font-size: 30px;
    -unity-font-style: bold;
    color: white;
    background-color: rgb(35, 91, 177);
    border-radius: 22px;
    border-width: 3px;
    border-color: rgb(255, 210, 92);
}

.combat-simulation-badge {
    position: absolute;
    right: 22px;
    top: 8px;
    padding: 8px 14px;
    background-color: rgb(129, 62, 20);
    border-radius: 12px;
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(255, 236, 185);
}

.academic-local-badge {
    position: absolute;
    right: 22px;
    top: 50px;
    padding: 6px 12px;
    background-color: rgb(67, 45, 113);
    border-radius: 10px;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(235, 220, 255);
}

.combat-attempt-panel {
    position: absolute;
    left: 18%;
    right: 18%;
    top: 35px;
    bottom: 35px;
    padding: 22px;
    align-items: center;
    background-color: rgba(5, 10, 24, 0.97);
    border-radius: 30px;
    border-width: 3px;
    border-color: rgb(104, 181, 255);
}

.combat-attempt-title {
    font-size: 20px;
    color: rgb(255, 209, 95);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.academic-question-meta {
    display: none;
    margin-top: 4px;
    font-size: 14px;
    color: rgb(167, 185, 214);
    -unity-text-align: middle-center;
}

.academic-question-prompt {
    display: none;
    margin-top: 5px;
    padding: 7px 14px;
    border-radius: 10px;
    background-color: rgba(76, 51, 121, 0.75);
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(244, 230, 255);
    -unity-text-align: middle-center;
}

.combat-timer {
    font-size: 64px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(126, 216, 255);
    transition-property: scale, color;
    transition-duration: 0.15s;
}

.combat-timer-caption {
    font-size: 15px;
    -unity-text-align: middle-center;
    color: rgb(187, 202, 226);
}

.combat-answer-display {
    width: 70%;
    min-height: 60px;
    margin: 10px 0;
    padding: 10px 18px;
    font-size: 34px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: rgb(238, 243, 255);
    color: rgb(17, 28, 52);
    border-radius: 14px;
}

.combat-answer--placeholder {
    color: rgb(111, 122, 143);
    -unity-font-style: normal;
}

.combat-numpad {
    width: 440px;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.combat-key {
    width: 92px;
    height: 64px;
    margin: 5px;
    font-size: 25px;
    -unity-font-style: bold;
    border-radius: 13px;
}

.combat-key--utility {
    width: 143px;
    font-size: 17px;
}

.combat-key--submit {
    width: 196px;
    background-color: rgb(38, 146, 89);
    color: white;
}

.combat-result {
    min-height: 34px;
    margin-top: 8px;
    font-size: 21px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.combat-result--positive {
    color: rgb(103, 239, 152);
}

.combat-result--negative {
    color: rgb(255, 127, 127);
}

.academic-currency-gain {
    display: none;
    min-height: 30px;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(255, 221, 93);
    -unity-text-align: middle-center;
}

.academic-rank-modal {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(4, 7, 16, 0.88);
}

.academic-rank-modal-card {
    width: 560px;
    min-height: 360px;
    padding: 34px;
    align-items: center;
    justify-content: center;
    background-color: rgb(22, 31, 55);
    border-width: 4px;
    border-color: rgb(118, 175, 255);
    border-radius: 30px;
    transition-property: scale, opacity;
    transition-duration: 0.22s;
}

.academic-rank-modal--promotion .academic-rank-modal-card {
    border-color: rgb(255, 211, 83);
    background-color: rgb(31, 43, 73);
}

.academic-rank-modal--adjustment .academic-rank-modal-card {
    border-color: rgb(143, 183, 230);
    background-color: rgb(30, 42, 61);
}

.academic-rank-modal-header {
    font-size: 42px;
    -unity-font-style: bold;
    color: rgb(255, 224, 112);
    -unity-text-align: middle-center;
}

.academic-rank-modal-route {
    margin-top: 18px;
    font-size: 34px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-center;
}

.academic-rank-modal-body,
.academic-rank-modal-multiplier {
    margin-top: 14px;
    font-size: 19px;
    color: rgb(213, 224, 244);
    white-space: normal;
    -unity-text-align: middle-center;
}

.academic-rank-continue-button {
    width: 240px;
    height: 64px;
    margin-top: 26px;
    font-size: 23px;
    -unity-font-style: bold;
    color: white;
    background-color: rgb(44, 126, 202);
    border-radius: 16px;
}

.combat-damage-label {
    position: absolute;
    top: 230px;
    font-size: 82px;
    -unity-font-style: bold;
    color: rgb(255, 237, 99);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(89, 16, 5);
    opacity: 0;
    scale: 0.65 0.65;
    translate: 0 35px;
    transition-property: opacity, scale, translate;
    transition-duration: 0.22s;
}

.combat-damage--animate {
    opacity: 1;
    scale: 1.2 1.2;
    translate: 0 -18px;
}

.combat-critical-label {
    position: absolute;
    top: 205px;
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(255, 137, 35);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(65, 11, 4);
}
