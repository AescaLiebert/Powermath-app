.mw-card {
    background-color: rgb(255, 249, 232);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(222, 199, 157);
    border-right-color: rgb(222, 199, 157);
    border-top-color: rgb(222, 199, 157);
    border-bottom-color: rgb(222, 199, 157);
    border-top-left-radius: 28px;
    border-top-right-radius: 28px;
    border-bottom-left-radius: 28px;
    border-bottom-right-radius: 28px;
}

.mw-button {
    min-height: 58px;
    padding-left: 24px;
    padding-right: 24px;
    color: rgb(20, 48, 91);
    background-color: rgb(255, 249, 232);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(222, 199, 157);
    border-right-color: rgb(222, 199, 157);
    border-top-color: rgb(222, 199, 157);
    border-bottom-color: rgb(222, 199, 157);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    font-size: 19px;
    -unity-font-style: bold;
    transition-duration: 0.16s;
    transition-timing-function: ease-out-back;
    transition-property: scale, translate, background-color, border-left-color, border-right-color, border-top-color, border-bottom-color;
}

.mw-button:hover,
.mw-button:focus {
    scale: 1.035 1.035;
    translate: 0 -2px;
    border-left-color: rgb(32, 92, 183);
    border-right-color: rgb(32, 92, 183);
    border-top-color: rgb(32, 92, 183);
    border-bottom-color: rgb(32, 92, 183);
}

.mw-button:active {
    scale: 0.94 0.94;
    translate: 0 2px;
    transition-duration: 0.08s;
}

.mw-button:disabled {
    opacity: 0.55;
    scale: 1 1;
    translate: 0 0;
}

.mw-button--primary {
    color: rgb(20, 48, 91);
    background-color: rgb(255, 184, 68);
    border-left-color: rgb(218, 120, 38);
    border-right-color: rgb(218, 120, 38);
    border-top-color: rgb(218, 120, 38);
    border-bottom-color: rgb(218, 120, 38);
}

.mw-button--primary:hover,
.mw-button--primary:focus {
    scale: 1.04 1.04;
    translate: 0 -2px;
    background-color: rgb(255, 197, 82);
    border-left-color: rgb(20, 48, 91);
    border-right-color: rgb(20, 48, 91);
    border-top-color: rgb(20, 48, 91);
    border-bottom-color: rgb(20, 48, 91);
}

.mw-button--primary:active {
    scale: 0.94 0.94;
    translate: 0 2px;
    transition-duration: 0.08s;
}

.mw-status {
    min-height: auto;
    padding: 12px;
    color: rgb(77, 101, 134);
    background-color: rgba(217, 239, 239, 0.55);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    font-size: 16px;
    white-space: normal;
    -unity-text-align: middle-center;
    translate: 0 0;
}

.mw-field {
    margin-bottom: 16px;
    color: rgb(20, 48, 91);
    font-size: 17px;
    display: flex;
}

.mw-field > .unity-text-field__label {
    width: auto;
    min-width: auto;
    flex-grow: 0;
    flex-shrink: 0;
    color: rgb(20, 48, 91);
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    display: flex;
    -unity-text-auto-size: none;
    -unity-text-generator: advanced;
    align-self: auto;
}

.mw-field > .unity-text-field__input {
    min-height: 54px;
    padding-left: 16px;
    padding-right: 16px;
    color: rgb(20, 48, 91);
    background-color: rgba(255, 255, 250, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-color: rgba(216, 199, 167, 0);
    border-right-color: rgba(216, 199, 167, 0);
    border-top-color: rgba(216, 199, 167, 0);
    border-bottom-color: rgba(216, 199, 167, 0);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

.mw-field > .unity-text-field__input:focus {
    border-left-color: rgb(32, 92, 183);
    border-right-color: rgb(32, 92, 183);
    border-top-color: rgb(32, 92, 183);
    border-bottom-color: rgb(32, 92, 183);
}

.auth-input-email {
}

/* =========================================================================
   Centralized Status Toast Notification Overlay
   ========================================================================= */

.status-toast-container {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: flex-start;
    pointer-events: none;
}

.status-toast-banner {
    position: absolute;
    top: 24px;
    left: 50%;
    translate: -50% -26px;
    opacity: 0;
    scale: 0.94 0.94;
    min-width: 360px;
    max-width: 680px;
    min-height: 50px;
    padding-left: 20px;
    padding-right: 24px;
    padding-top: 10px;
    padding-bottom: 10px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgba(20, 48, 91, 0.97);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(95, 211, 225);
    border-right-color: rgb(95, 211, 225);
    border-top-color: rgb(95, 211, 225);
    border-bottom-color: rgb(95, 211, 225);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
    transition-property: opacity, translate, scale, background-color, border-left-color, border-right-color, border-top-color, border-bottom-color;
    transition-duration: 0.22s;
    transition-timing-function: ease-out-back;
}

.status-toast-banner.is-visible {
    opacity: 1;
    translate: -50% 0;
    scale: 1 1;
}

.status-toast-banner.status-toast--info {
    background-color: rgba(20, 48, 91, 0.97);
    border-left-color: rgb(95, 211, 225);
    border-right-color: rgb(95, 211, 225);
    border-top-color: rgb(95, 211, 225);
    border-bottom-color: rgb(95, 211, 225);
}

.status-toast-banner.status-toast--success {
    background-color: rgba(18, 99, 68, 0.98);
    border-left-color: rgb(128, 242, 171);
    border-right-color: rgb(128, 242, 171);
    border-top-color: rgb(128, 242, 171);
    border-bottom-color: rgb(128, 242, 171);
}

.status-toast-banner.status-toast--warning {
    background-color: rgba(109, 70, 17, 0.98);
    border-left-color: rgb(255, 202, 84);
    border-right-color: rgb(255, 202, 84);
    border-top-color: rgb(255, 202, 84);
    border-bottom-color: rgb(255, 202, 84);
}

.status-toast-banner.status-toast--error {
    background-color: rgba(128, 43, 51, 0.98);
    border-left-color: rgb(255, 148, 130);
    border-right-color: rgb(255, 148, 130);
    border-top-color: rgb(255, 148, 130);
    border-bottom-color: rgb(255, 148, 130);
}

.status-toast__badge {
    min-width: 26px;
    min-height: 26px;
    margin-right: 12px;
    -unity-text-align: middle-center;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.status-toast__text {
    color: rgb(255, 249, 232);
    font-size: 16px;
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: middle-left;
    flex-shrink: 1;
}

