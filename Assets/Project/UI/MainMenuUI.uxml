    <Style src="project://database/Assets/Project/UI/MainMenu/MainMenuExperience.uss?fileID=7433441132597879392&amp;guid=a3168f27716975f42a77b8d15d9be5c1&amp;type=3#MainMenuExperience"/>
    <Style src="project://database/Assets/Project/UI/MainMenu/PlayerHubPanel.uss?fileID=7433441132597879392&amp;guid=6c719429dbb49c14b86d3fe58b0df7ec&amp;type=3#PlayerHubPanel"/>
    <Style src="project://database/Assets/Project/UI/MainMenu/RebirthPanel.uss?fileID=7433441132597879392&amp;guid=f55d322181168c747ab659406eb947e6&amp;type=3#RebirthPanel"/>
