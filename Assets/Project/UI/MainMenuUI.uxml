<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="MainMenuShell" src="project://database/Assets/Project/UI/MainMenu/MainMenuShell.uxml"/>
    <ui:Template name="CombatSurface" src="project://database/Assets/Project/UI/MainMenu/CombatSurface.uxml"/>
    <ui:Template name="LegacyFeaturePanels" src="project://database/Assets/Project/UI/MainMenu/LegacyFeaturePanels.uxml"/>
    <Style src="project://database/Assets/Project/UI/Theme/MathWorldPalette.uss"/>
    <Style src="project://database/Assets/Project/UI/Theme/MathWorldTypography.uss"/>
    <Style src="project://database/Assets/Project/UI/Theme/MathWorldControls.uss"/>
    <Style src="project://database/Assets/Project/UI/Theme/MathWorldStates.uss"/>
    <Style src="project://database/Assets/Project/UI/CombatLobbyUI.uss"/>
    <Style src="project://database/Assets/Project/UI/MainMenu/MainMenuExperience.uss"/>
    <Style src="project://database/Assets/Project/UI/MainMenu/PlayerHubPanel.uss"/>
    <Style src="project://database/Assets/Project/UI/MainMenu/RebirthPanel.uss"/>
    <Style src="project://database/Assets/Project/UI/MainMenu/PetGachaPanel.uss"/>
    <Style src="project://database/Assets/Project/UI/MainMenu/LeaderboardPanel.uss"/>
    <Style src="project://database/Assets/Project/UI/MainMenu/ProfileAnalyticsPanel.uss"/>
    <ui:VisualElement name="main-menu-screen" class="mw-screen main-menu-root is-ready">
        <ui:VisualElement name="safe-area" class="mw-safe-area main-menu-safe-area">
            <ui:Instance template="MainMenuShell" picking-mode="Ignore" class="mw-template-fill"/>
            <ui:Instance template="CombatSurface" picking-mode="Ignore" class="mw-template-fill"/>
            <ui:Instance template="LegacyFeaturePanels" picking-mode="Ignore" class="mw-template-fill"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
