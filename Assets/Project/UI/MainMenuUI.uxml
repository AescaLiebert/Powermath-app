    <Style src="project://database/Assets/Project/UI/MainMenu/LeaderboardPanel.uss?fileID=7433441132597879392&amp;guid=9cb9d7a720d16eb4db4946f3cbb1a86e&amp;type=3#LeaderboardPanel"/>
    <Style src="project://database/Assets/Project/UI/MainMenu/ProfileAnalyticsPanel.uss?fileID=7433441132597879392&amp;guid=6ee03a27eb16be44caacfddce5237c0f&amp;type=3#ProfileAnalyticsPanel"/>
    <Style src="project://database/Assets/Project/UI/MainMenu/AdminPanel.uss?fileID=7433441132597879392&amp;guid=0cd82efce4261564b869fe4761529a07&amp;type=3#AdminPanel"/>
    <Style src="project://database/Assets/Project/UI/MainMenu/MainMenuSharedOverlay.uss?fileID=7433441132597879392&amp;guid=0ab46313332b46e8a9fa5e40c123c9d5&amp;type=3#MainMenuSharedOverlay"/>
    <ui:VisualElement name="main-menu-screen" picking-mode="Ignore" class="mw-screen main-menu-root is-ready">
        <ui:VisualElement name="safe-area" picking-mode="Ignore" class="mw-safe-area main-menu-safe-area">
            <ui:Instance template="MainMenuShell" picking-mode="Ignore" class="mw-template-fill"/>
            <ui:Instance template="CombatSurface" picking-mode="Ignore" class="mw-template-fill"/>
            <ui:Instance template="LegacyFeaturePanels" picking-mode="Ignore" class="mw-template-fill"/>
        </ui:VisualElement>
        <ui:VisualElement name="main-menu-utility-bar" class="main-menu-utility-bar" style="left: auto;">
            <ui:Button name="main-menu-utility-back" text="X" tooltip="Back" class="main-menu-utility-back" style="border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; margin-right: 4px;"/>
            <ui:Label name="main-menu-utility-power-coins" text="PWR 0" class="main-menu-utility-currency main-menu-utility-currency--power"/>
        </ui:VisualElement>
        <ui:VisualElement name="main-menu-notification" picking-mode="Ignore" class="main-menu-notification" style="flex-direction: column; bottom: auto; top: 50px;">
            <ui:Label name="main-menu-notification-text" text="" picking-mode="Ignore" class="main-menu-notification__text"/>
        </ui:VisualElement>
        <ui:VisualElement name="main-menu-transition-layer" picking-mode="Ignore" class="main-menu-transition-layer">
            <ui:VisualElement name="main-menu-transition-cover" picking-mode="Ignore" class="main-menu-transition-cover"/>
            <ui:VisualElement name="transition-square-0" picking-mode="Ignore" class="battle-transition-square battle-transition-square--0"/>
            <ui:VisualElement name="transition-square-1" picking-mode="Ignore" class="battle-transition-square battle-transition-square--1"/>
            <ui:VisualElement name="transition-square-2" picking-mode="Ignore" class="battle-transition-square battle-transition-square--2"/>
            <ui:VisualElement name="transition-square-3" picking-mode="Ignore" class="battle-transition-square battle-transition-square--3"/>
            <ui:VisualElement name="transition-square-4" picking-mode="Ignore" class="battle-transition-square battle-transition-square--4"/>
            <ui:VisualElement name="transition-square-5" picking-mode="Ignore" class="battle-transition-square battle-transition-square--5"/>
            <ui:VisualElement name="transition-square-6" picking-mode="Ignore" class="battle-transition-square battle-transition-square--6"/>
            <ui:VisualElement name="transition-square-7" picking-mode="Ignore" class="battle-transition-square battle-transition-square--7"/>
            <ui:VisualElement name="transition-square-8" picking-mode="Ignore" class="battle-transition-square battle-transition-square--8"/>
            <ui:VisualElement name="battle-start-accent-left" picking-mode="Ignore" class="battle-start-accent battle-start-accent--left"/>
            <ui:VisualElement name="battle-start-accent-right" picking-mode="Ignore" class="battle-start-accent battle-start-accent--right"/>
            <ui:Label name="battle-start-title" text="————  ×  BATTLE!  ×  ————" picking-mode="Ignore" class="battle-start-title"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
