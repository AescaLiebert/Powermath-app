.auth-root {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background-color: rgb(24, 29, 45);
}

.auth-safe-area {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.auth-card {
    width: 560px;
    padding: 42px;
    background-color: rgb(43, 52, 78);
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    border-bottom-right-radius: 24px;
    border-bottom-left-radius: 24px;
}

.auth-title {
    color: rgb(242, 194, 74);
    font-size: 44px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.auth-subtitle {
    margin-top: 6px;
    margin-bottom: 30px;
    color: rgb(226, 230, 241);
    font-size: 20px;
    -unity-text-align: middle-center;
}

.login-input {
    height: 58px;
    margin-bottom: 16px;
    color: white;
    font-size: 19px;
}

.login-input > .unity-text-field__label {
    width: 145px;
    min-width: 145px;
    flex-grow: 0;
    flex-shrink: 0;
    -unity-font-style: bold;
}

.login-input > .unity-text-field__input {
    padding-left: 14px;
    color: rgb(30, 30, 30);
    background-color: rgb(245, 245, 245);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(125, 132, 153);
    border-right-color: rgb(125, 132, 153);
    border-top-color: rgb(125, 132, 153);
    border-bottom-color: rgb(125, 132, 153);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

.remember-toggle {
    margin-top: 4px;
    color: white;
    font-size: 18px;
}

.shared-device-warning {
    margin-top: 6px;
    color: rgb(207, 211, 225);
    font-size: 15px;
    white-space: normal;
}

.auth-status {
    min-height: 50px;
    margin-top: 20px;
    color: rgb(226, 230, 241);
    font-size: 17px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.auth-status--error {
    color: rgb(255, 151, 151);
}

.auth-status--success {
    color: rgb(150, 235, 174);
}

.login-button {
    height: 58px;
    margin-top: 8px;
    color: rgb(24, 29, 45);
    background-color: rgb(242, 194, 74);
    font-size: 23px;
    -unity-font-style: bold;
}

.editor-sample-hint {
    margin-top: 18px;
    padding: 12px;
    color: rgb(178, 220, 255);
    background-color: rgb(32, 39, 59);
    font-size: 14px;
    white-space: normal;
    -unity-text-align: middle-center;
}
