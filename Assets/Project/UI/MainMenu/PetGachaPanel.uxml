<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xmlns:pm="PowerMath.UI.Core" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Project/UI/MainMenu/PetGachaPanel.uss?fileID=7433441132597879392&amp;guid=3d40160347b7bcc449b9a900de6ae62a&amp;type=3#PetGachaPanel"/>
    <ui:VisualElement name="pet-gacha-modal" enabled="true" focusable="true" class="social-modal pet-gacha-modal gacha-screen gacha-screen--banner is-hidden" style="display: flex; -unity-font-definition: url(&quot;project://database/Assets/Project/Fonts/Genshin-text-Font.asset?fileID=11400000&amp;guid=be35bd2da95a032498ece6b468888b91&amp;type=2#Genshin-text-Font&quot;);">
        <pm:FigmaGradientElement name="Gacha / Screen Gradient" class="gacha-screen-gradient" style="opacity: 1;"/>
        <ui:VisualElement name="BG" picking-mode="Ignore" class="gacha-bg" style="width: auto; height: auto; left: 0; top: 0; background-image: url(&quot;project://database/Assets/Project/Art/UI/illustration/Gacha%20Banner.png?fileID=2800000&amp;guid=4c27ff18d962de347a4ab3eabfd169e2&amp;type=3#Gacha Banner&quot;); right: 0; bottom: 0; opacity: 1;"/>
        <ui:VisualElement name="[UI] .gacha-topbar" class="gacha-topbar" style="opacity: 0;">
            <ui:VisualElement name="3. Utilities Composition" class="gacha-utilities-composition">
                <ui:VisualElement name="Power-Coin_Currency-field" class="gacha-currency-field">
                    <ui:VisualElement name="Currency" class="gacha-currency-surface">
                        <ui:VisualElement name="Currency_Value" class="gacha-currency-value-wrap">
                            <ui:Label name="pet-gacha-balance" text="2,300" class="gacha-currency-value" style="color: rgb(0, 0, 0);"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="Power-Coin-Icon" picking-mode="Ignore" class="gacha-power-coin-icon"/>
                </ui:VisualElement>
                <ui:VisualElement name="BackBtn" class="gacha-back-frame">
                    <pm:FigmaShadowElement name="Gacha / Control Shadow" class="gacha-control-shadow"/>
                    <ui:Button name="pet-gacha-close" text="" tooltip="Close Pet Gacha" class="gacha-back-button">
                        <ui:VisualElement name="Vector" picking-mode="Ignore" class="gacha-back-vector gacha-back-vector--a"/>
                        <ui:VisualElement name="Vector" picking-mode="Ignore" class="gacha-back-vector gacha-back-vector--b"/>
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="[UI] .gacha-banner-main" class="gacha-banner-main">
            <ui:VisualElement name=".gacha-banner-copy" class="gacha-banner-copy" style="opacity: 0;">
                <ui:VisualElement name="Frame 6" class="gacha-heading-group">
                    <ui:Label name=".gacha-title" text="ANIMO CALL" class="gacha-title"/>
                    <ui:VisualElement name="Ornament / Celestial Divider" picking-mode="Ignore" class="gacha-celestial-divider">
                        <ui:VisualElement name="Vector" class="gacha-divider-line"/>
                        <ui:VisualElement name="Vector" class="gacha-divider-diamond"/>
                        <ui:VisualElement name="Vector" class="gacha-divider-line"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name=".gacha-guarantee" text="3◆+ WITHIN 10" class="gacha-guarantee"/>
                <ui:Label name=".gacha-helper" text="Review details or history before summoning." class="gacha-helper"/>
            </ui:VisualElement>
            <ui:VisualElement name="[PET] .gacha-featured-stage" picking-mode="Ignore" class="gacha-featured-stage" style="opacity: 0;">
                <ui:VisualElement name="SSR5_Lunamoth 1" class="gacha-featured-pet gacha-featured-pet--lunamoth" style="top: 7%;"/>
                <ui:VisualElement name="SSR4_Auregriff 1" class="gacha-featured-pet gacha-featured-pet--auregriff" style="top: 38%; left: -3%;"/>
                <ui:VisualElement name="SSR3_GoldenCrane 1" class="gacha-featured-pet gacha-featured-pet--golden-crane" style="top: 42%; left: 41%;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="[UI] .gacha-banner-footer" class="gacha-banner-footer" style="opacity: 0;">
            <ui:VisualElement name=".gacha-secondary-actions" class="gacha-secondary-actions">
                <ui:VisualElement name="Gacha/Button/Secondary" class="gacha-secondary-frame">
                    <pm:FigmaShadowElement name="Gacha / Control Shadow" class="gacha-control-shadow"/>
                    <ui:Button name="pet-gacha-details" text="" class="gacha-secondary-button">
                        <ui:Label name="#button-label" text="DETAILS" picking-mode="Ignore" class="gacha-secondary-label"/>
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement name="Gacha/Button/Secondary" class="gacha-secondary-frame">
                    <pm:FigmaShadowElement name="Gacha / Control Shadow" class="gacha-control-shadow"/>
                    <ui:Button name="pet-gacha-history" text="" tooltip="Summon history is coming soon" class="gacha-secondary-button">
                        <ui:Label name="#button-label" text="HISTORY" picking-mode="Ignore" class="gacha-secondary-label"/>
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name=".gacha-summon-actions" class="gacha-summon-actions" style="padding-left: 100px;">
                <ui:VisualElement name="Button / Rebirth" class="gacha-summon-frame">
                    <pm:FigmaShadowElement name="Gacha / Control Shadow" class="gacha-control-shadow gacha-control-shadow--summon"/>
                    <ui:Button name="pet-gacha-pull-1" text="" class="gacha-summon-button gacha-summon-button--single" style="display: flex; padding-right: 12px; padding-left: 12px;">
                        <ui:Label name="pet-gacha-single-label" text="x1" picking-mode="Ignore" class="gacha-summon-count" style="position: absolute; align-items: flex-start; top: 18px; left: 24px; -unity-font-definition: url(&quot;project://database/Assets/Project/Fonts/Genshin-text-Font.asset?fileID=11400000&amp;guid=be35bd2da95a032498ece6b468888b91&amp;type=2#Genshin-text-Font&quot;);"/>
                        <ui:VisualElement name="Power-Coin-Icon" picking-mode="Ignore" class="gacha-summon-coin" style="position: absolute; top: 20px; left: 168px;"/>
                        <ui:Label name="pet-gacha-single-cost" text="180" picking-mode="Ignore" class="gacha-summon-cost" style="-unity-font-definition: url(&quot;project://database/Assets/Project/Fonts/Genshin-text-Font.asset?fileID=11400000&amp;guid=be35bd2da95a032498ece6b468888b91&amp;type=2#Genshin-text-Font&quot;); position: absolute; top: 18px; left: 237px;"/>
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement name="Button / Rebirth" class="gacha-summon-frame">
                    <pm:FigmaShadowElement name="Gacha / Control Shadow" class="gacha-control-shadow gacha-control-shadow--summon"/>
                    <ui:Button name="pet-gacha-pull-10" text="" tooltip="Summon 10 pets" class="gacha-summon-button gacha-summon-button--multi">
                        <ui:Label name="pet-gacha-multi-label" text="x10" picking-mode="Ignore" class="gacha-summon-count" style="-unity-font-definition: url(&quot;project://database/Assets/Project/Fonts/Genshin-text-Font.asset?fileID=11400000&amp;guid=be35bd2da95a032498ece6b468888b91&amp;type=2#Genshin-text-Font&quot;);"/>
                        <ui:VisualElement name="Power-Coin-Icon" picking-mode="Ignore" class="gacha-summon-coin"/>
                        <ui:Label name="pet-gacha-multi-cost" text="1,800" picking-mode="Ignore" class="gacha-summon-cost" style="-unity-font-definition: url(&quot;project://database/Assets/Project/Fonts/Genshin-text-Font.asset?fileID=11400000&amp;guid=be35bd2da95a032498ece6b468888b91&amp;type=2#Genshin-text-Font&quot;);"/>
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="pet-gacha-status" text="" class="social-status mw-status pet-gacha-status"/>
        <ui:VisualElement name="pet-gacha-details-drawer" focusable="true" class="pet-gacha-overlay pet-gacha-details-drawer is-hidden" style="display: none;">
            <ui:VisualElement class="pet-gacha-details-card">
                <ui:VisualElement class="pet-gacha-details-header">
                    <ui:Label name="pet-gacha-catalog-status" text="CURRENT ODDS" class="pet-gacha-catalog-status"/>
                    <ui:Button name="pet-gacha-details-close" text="×" tooltip="Close details" class="pet-gacha-details-close"/>
                </ui:VisualElement>
                <ui:Label name="pet-gacha-warning" text="Owned pets stack in your inventory." class="pet-gacha-warning"/>
                <ui:ScrollView name="pet-gacha-odds-list" class="pet-gacha-odds-list"/>
                <ui:VisualElement class="pet-gacha-wallet-row">
                    <ui:Label name="pet-gacha-cost" text="1x: 180 PC | 10x: 1,800 PC" class="pet-gacha-wallet pet-gacha-wallet--cost"/>
                    <ui:Label name="pet-gacha-projected-balance" text="AFTER PULL: —" class="pet-gacha-wallet pet-gacha-wallet--projected"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="pet-gacha-confirmation" focusable="true" class="pet-gacha-overlay pet-gacha-confirmation is-hidden" style="display: none;">
            <ui:VisualElement picking-mode="Ignore" class="pet-gacha-confirmation-orbit">
                <ui:VisualElement picking-mode="Ignore" class="pet-gacha-confirmation-mark pet-gacha-star-icon"/>
            </ui:VisualElement>
            <ui:VisualElement class="pet-gacha-confirmation-card">
                <ui:Label name="pet-gacha-confirmation-title" text="CONFIRM PULL" class="loc-menu.confirmOnePull pet-gacha-overlay-title"/>
                <ui:Label name="pet-gacha-confirmation-summary" text="Spend 180 Power Coins?" class="loc-menu.spend pet-gacha-confirmation-summary"/>
                <ui:VisualElement class="pet-gacha-actions">
                    <ui:Button name="pet-gacha-cancel" text="CANCEL" class="loc-common.cancel social-close pet-gacha-cancel"/>
                    <ui:Button name="pet-gacha-confirm" text="CONFIRM PULL" class="loc-menu.confirmPull pet-gacha-pull pet-gacha-confirm"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="pet-gacha-transition" focusable="true" class="pet-gacha-overlay pet-gacha-transition is-hidden" style="display: none;">
            <ui:Label text="ANIMO CALL" picking-mode="Ignore" class="pet-gacha-transition-watermark"/>
            <ui:Button name="pet-gacha-transition-skip" text="SKIP" class="gacha-secondary-button pet-gacha-transition-skip"/>
            <ui:VisualElement picking-mode="Ignore" class="pet-gacha-transition-vortex">
                <ui:VisualElement class="pet-gacha-transition-vortex-ring pet-gacha-transition-vortex-ring--outer"/>
                <ui:VisualElement class="pet-gacha-transition-vortex-ring pet-gacha-transition-vortex-ring--inner"/>
            </ui:VisualElement>
            <ui:VisualElement picking-mode="Ignore" class="pet-gacha-transition-comet">
                <ui:VisualElement class="pet-gacha-transition-comet-trail"/>
                <ui:VisualElement class="pet-gacha-transition-comet-core"/>
            </ui:VisualElement>
            <ui:VisualElement picking-mode="Ignore" class="pet-gacha-transition-flare"/>
            <ui:VisualElement picking-mode="Ignore" class="pet-gacha-transition-compass">
                <ui:VisualElement class="pet-gacha-transition-compass-ring"/>
                <ui:VisualElement class="pet-gacha-transition-compass-diamond"/>
            </ui:VisualElement>
            <ui:VisualElement name="pet-gacha-transition-tokens" picking-mode="Ignore" class="pet-gacha-transition-tokens"/>
            <ui:Label name="pet-gacha-transition-headline" text="THE CALL RESONATES" picking-mode="Ignore" class="pet-gacha-transition-headline"/>
            <ui:Label text="R • SR • SSR" picking-mode="Ignore" class="pet-gacha-transition-legend"/>
        </ui:VisualElement>
        <ui:VisualElement name="pet-gacha-result" focusable="true" class="pet-gacha-overlay pet-gacha-result is-hidden" style="display: flex; opacity: 1;">
            <ui:VisualElement name="pet-gacha-reveal" class="pet-gacha-reveal gacha-showcase-screen is-reveal-sequencing">
                <pm:FigmaGradientElement name="Gacha / Showcase Gradient" class="gacha-showcase-gradient" style="display: flex;"/>
                <ui:VisualElement name="BG" picking-mode="Ignore" class="gacha-showcase-bg" style="background-image: url(&quot;project://database/Assets/Project/Art/UI/illustration/Gacha%20Banner.png?fileID=6903241956423549783&amp;guid=4c27ff18d962de347a4ab3eabfd169e2&amp;type=3#Gacha Banner (1)_0&quot;);"/>
                <ui:VisualElement name="[UI] .gacha-topbar" class="gacha-showcase-topbar">
                    <ui:Label name="pet-gacha-reveal-progress" text="REVEAL 1 / 1" class="gacha-showcase-progress"/>
                    <ui:VisualElement name=".gacha-topbar-actions" class="gacha-showcase-topbar-actions">
                        <ui:VisualElement name="Gacha/Button/Secondary" class="gacha-showcase-skip-frame">
                            <pm:FigmaShadowElement name="Gacha / Control Shadow" class="gacha-control-shadow"/>
                            <ui:Button name="pet-gacha-reveal-skip" text="" class="gacha-secondary-button gacha-showcase-skip">
                                <ui:Label name="#button-label" text="SKIP ALL" picking-mode="Ignore" class="gacha-secondary-label"/>
                            </ui:Button>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name=".gacha-showcase-main" class="gacha-showcase-main">
                    <ui:VisualElement name="[UI] .gacha-showcase-copy" class="gacha-showcase-copy" style="display: flex;">
                        <ui:VisualElement name=".gacha-new-badge" class="gacha-new-badge" style="display: flex;">
                            <ui:VisualElement name=".gacha-new-label" class="gacha-new-label-wrap">
                                <ui:Label name="pet-gacha-result-state" text="NEW ✦" class="gacha-new-label"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="#gacha-pet-name" class="gacha-showcase-pet-name-wrap">
                            <ui:Label name="pet-gacha-result-name" text="ANIMO NAME" class="gacha-showcase-pet-name"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="Ornament / Celestial Divider" picking-mode="Ignore" class="gacha-showcase-divider">
                            <ui:VisualElement name="Vector" class="gacha-showcase-divider-line gacha-showcase-divider-line--left"/>
                            <ui:VisualElement name="Vector" class="gacha-showcase-divider-line gacha-showcase-divider-line--right"/>
                            <pm:StageInfoVectorPath name="Vector" class="gacha-showcase-divider-diamond"/>
                            <ui:VisualElement name="Vector" class="gacha-showcase-divider-tick gacha-showcase-divider-tick--left"/>
                            <ui:VisualElement name="Vector" class="gacha-showcase-divider-tick gacha-showcase-divider-tick--right"/>
                        </ui:VisualElement>
                        <ui:VisualElement name=".gacha-rarity" class="gacha-showcase-rarity">
                            <ui:VisualElement name="star" class="pet-gacha-result-star" style="background-image: url(&quot;project://database/Assets/Project/Art/UI/Icon/Generic_Star.png?fileID=2800000&amp;guid=3b4a2a288ce72154cafb0fc1c6f508d5&amp;type=3#Generic_Star&quot;);"/>
                            <ui:VisualElement name="star" class="pet-gacha-result-star" style="background-image: url(&quot;project://database/Assets/Project/Art/UI/Icon/Generic_Star.png?fileID=2800000&amp;guid=3b4a2a288ce72154cafb0fc1c6f508d5&amp;type=3#Generic_Star&quot;);"/>
                            <ui:VisualElement name="star" class="pet-gacha-result-star" style="background-image: url(&quot;project://database/Assets/Project/Art/UI/Icon/Generic_Star.png?fileID=2800000&amp;guid=3b4a2a288ce72154cafb0fc1c6f508d5&amp;type=3#Generic_Star&quot;);"/>
                            <ui:VisualElement name="star" class="pet-gacha-result-star" style="background-image: url(&quot;project://database/Assets/Project/Art/UI/Icon/Generic_Star.png?fileID=2800000&amp;guid=3b4a2a288ce72154cafb0fc1c6f508d5&amp;type=3#Generic_Star&quot;);"/>
                            <ui:VisualElement name="star" class="pet-gacha-result-star" style="background-image: url(&quot;project://database/Assets/Project/Art/UI/Icon/Generic_Star.png?fileID=2800000&amp;guid=3b4a2a288ce72154cafb0fc1c6f508d5&amp;type=3#Generic_Star&quot;);"/>
                        </ui:VisualElement>
                        <ui:Label name="pet-gacha-result-rarity" text="RARITY" class="pet-gacha-result-rarity gacha-showcase-data-label"/>
                        <ui:Label name="pet-gacha-result-balance" text="POWER COINS: —" class="pet-gacha-result-balance gacha-showcase-data-label"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="[PET] .gacha-showcase-stage" class="gacha-showcase-stage" style="display: flex;">
                        <ui:VisualElement name="SSR5_Lunamoth 1" class="gacha-showcase-pet-wrap" style="display: flex;">
                            <ui:VisualElement picking-mode="Ignore" class="gacha-reveal-burst">
                                <ui:VisualElement picking-mode="Ignore" class="gacha-reveal-halo"/>
                                <ui:VisualElement class="gacha-reveal-shard gacha-reveal-shard--0"/>
                                <ui:VisualElement class="gacha-reveal-shard gacha-reveal-shard--30"/>
                                <ui:VisualElement class="gacha-reveal-shard gacha-reveal-shard--60"/>
                                <ui:VisualElement class="gacha-reveal-shard gacha-reveal-shard--90"/>
                                <ui:VisualElement class="gacha-reveal-shard gacha-reveal-shard--120"/>
                                <ui:VisualElement class="gacha-reveal-shard gacha-reveal-shard--150"/>
                            </ui:VisualElement>
                            <ui:Image name="pet-gacha-result-silhouette" picking-mode="Ignore" class="gacha-showcase-pet gacha-showcase-pet--silhouette"/>
                            <ui:Image name="pet-gacha-result-icon" class="pet-gacha-result-icon gacha-showcase-pet"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement picking-mode="Ignore" class="gacha-reveal-flash"/>
                <ui:Label name="pet-gacha-reveal-tap-hint" text="TAP ANYWHERE TO CONTINUE" picking-mode="Ignore" class="gacha-reveal-tap-hint"/>
            </ui:VisualElement>
            <ui:VisualElement name="pet-gacha-results" class="pet-gacha-results is-hidden" style="display: none;">
                <ui:VisualElement class="pet-gacha-multi-header">
                    <ui:Label text="SUMMON RESULTS" class="pet-gacha-multi-title"/>
                    <ui:Label name="pet-gacha-results-balance" text="POWER COINS: —" class="pet-gacha-multi-balance"/>
                </ui:VisualElement>
                <ui:ScrollView name="pet-gacha-multi-scroll" class="pet-gacha-multi-scroll">
                    <ui:VisualElement name="pet-gacha-results-grid" class="pet-gacha-multi-grid"/>
                </ui:ScrollView>
                <ui:VisualElement class="pet-gacha-multi-footer">
                    <ui:Button name="pet-gacha-results-continue" text="CONTINUE" class="loc-common.continue pet-gacha-pull pet-gacha-multi-continue"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="pet-gacha-open-curtain" class="pet-gacha-open-curtain" style="display: none; opacity: 0;"/>
</ui:UXML>
