.leaderboard-modal {
    color: rgb(20, 48, 91);
    background-color: rgb(255, 249, 232);
}

.leaderboard-backdrop {
    position: absolute;
    border-radius: 50%;
}

.leaderboard-backdrop--cyan {
    left: -17%;
    top: -42%;
    width: 56%;
    height: 122%;
    background-color: rgba(95, 211, 225, 0.72);
}

.leaderboard-backdrop--cobalt {
    right: -20%;
    bottom: -48%;
    width: 68%;
    height: 124%;
    background-color: rgb(32, 92, 183);
    border-width: 16px;
    border-color: rgba(95, 211, 225, 0.72);
}

.leaderboard-watermark {
    position: absolute;
    left: -15px;
    bottom: -56px;
    color: rgba(20, 48, 91, 0.07);
    font-size: 190px;
    -unity-font-style: bold;
    letter-spacing: -7px;
}

.leaderboard-shell {
    position: absolute;
    left: 42px;
    right: 42px;
    top: 28px;
    bottom: 28px;
}

.leaderboard-header {
    min-height: 104px;
    padding: 0 8px;
    flex-direction: row;
    align-items: center;
}

.leaderboard-heading {
    flex-grow: 1;
}

.leaderboard-title {
    color: rgb(20, 48, 91);
    font-size: 49px;
    -unity-font-style: bold;
    letter-spacing: -1px;
}

.leaderboard-rule {
    color: rgb(46, 84, 122);
    font-size: 15px;
    -unity-font-style: bold;
}

.leaderboard-cohort {
    min-width: 250px;
    min-height: 52px;
    padding: 12px 20px;
    color: rgb(20, 48, 91);
    background-color: rgb(219, 241, 246);
    border-radius: 15px;
    border-width: 3px;
    border-color: rgb(32, 92, 183);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.leaderboard-header-actions {
    min-width: 360px;
    margin-left: 18px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

.leaderboard-status {
    max-width: 235px;
    margin-right: 10px;
    color: rgb(46, 84, 122);
    font-size: 13px;
    white-space: normal;
    -unity-text-align: middle-right;
}

.leaderboard-icon-button {
    min-width: 54px;
    width: 54px;
    min-height: 54px;
    height: 54px;
    margin-left: 9px;
    padding: 0;
    color: rgb(20, 48, 91);
    background-color: rgb(255, 249, 232);
    border-radius: 15px;
    border-width: 3px;
    border-color: rgb(222, 199, 157);
    font-size: 31px;
    -unity-font-style: bold;
    transition-property: scale, translate, background-color, border-color;
    transition-duration: 0.16s;
    transition-timing-function: ease-out-back;
}

.leaderboard-icon-button:hover,
.leaderboard-icon-button:focus {
    scale: 1.06 1.06;
    translate: 0 -2px;
    border-color: rgb(255, 194, 64);
    background-color: white;
}

.leaderboard-icon-button:active {
    scale: 0.94 0.94;
    translate: 0 1px;
    transition-duration: 0.08s;
}

.leaderboard-content {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
}

.leaderboard-showcase {
    width: 31%;
    margin: 8px 10px 8px 0;
    padding: 28px 26px;
    align-items: center;
    justify-content: center;
    background-color: rgb(32, 92, 183);
    border-radius: 25px;
    border-width: 5px;
    border-color: rgb(95, 211, 225);
}

.leaderboard-showcase-kicker {
    padding: 7px 21px;
    color: rgb(20, 48, 91);
    background-color: rgb(255, 230, 181);
    border-radius: 18px;
    font-size: 17px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.leaderboard-crown {
    width: 150px;
    height: 150px;
    margin-top: 22px;
    color: rgb(255, 184, 68);
    background-color: rgba(255, 249, 232, 0.14);
    border-radius: 50%;
    border-width: 6px;
    border-color: rgb(255, 249, 232);
    font-size: 82px;
    -unity-text-align: middle-center;
    transition-property: scale;
    transition-duration: 0.25s;
    transition-timing-function: ease-out-back;
}

.leaderboard-throne {
    width: 100%;
    margin-top: 18px;
    color: white;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.leaderboard-public-note {
    margin-top: 20px;
    padding: 10px 14px;
    color: rgb(20, 48, 91);
    background-color: rgb(219, 241, 246);
    border-radius: 12px;
    font-size: 12px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.leaderboard-standing-column {
    flex-grow: 1;
    min-width: 0;
    margin: 8px 0 8px 10px;
}

.leaderboard-self-card {
    min-height: 94px;
    padding: 13px 20px;
    background-color: rgb(207, 240, 213);
    border-radius: 19px;
    border-width: 4px;
    border-color: rgb(34, 126, 82);
}

.leaderboard-self-kicker {
    color: rgb(34, 105, 78);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.leaderboard-self {
    margin-top: 4px;
    color: rgb(20, 78, 58);
    font-size: 21px;
    -unity-font-style: bold;
    white-space: normal;
}

.leaderboard-column-headings {
    min-height: 39px;
    padding: 10px 14px 6px;
    flex-direction: row;
    justify-content: space-between;
}

.leaderboard-column-heading {
    width: 18%;
    color: rgb(46, 84, 122);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.leaderboard-column-heading--player {
    width: 27%;
    -unity-text-align: middle-left;
}

.leaderboard-list {
    flex-grow: 1;
    min-height: 0;
    padding: 9px;
    background-color: rgba(255, 249, 232, 0.96);
    border-radius: 17px;
    border-width: 3px;
    border-color: rgb(32, 92, 183);
}

.leaderboard-row {
    min-height: 88px;
    margin-bottom: 9px;
    padding: 10px 12px;
    flex-direction: row;
    align-items: center;
    color: rgb(20, 48, 91);
    background-color: rgb(239, 244, 239);
    border-radius: 14px;
    border-width: 2px;
    border-color: rgb(166, 199, 195);
    transition-property: scale, translate, background-color, border-color;
    transition-duration: 0.15s;
    transition-timing-function: ease-out-back;
}

.leaderboard-row:hover {
    scale: 1.015 1.015;
    translate: 2px 0;
    border-color: rgb(255, 194, 64);
}

.leaderboard-row-rank {
    width: 11%;
    font-size: 21px;
    -unity-font-style: bold;
}

.leaderboard-row-player {
    width: 22%;
    font-size: 17px;
    -unity-font-style: bold;
    white-space: normal;
}

.leaderboard-row-stage,
.leaderboard-row-currency,
.leaderboard-row-loadout,
.leaderboard-row-damage {
    width: 17%;
    padding: 0 5px;
    font-size: 12px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.leaderboard-row-loadout {
    width: 20%;
}

.leaderboard-row-damage {
    width: 13%;
    -unity-font-style: bold;
}

.leaderboard-row--diamond {
    background-color: rgb(219, 241, 246);
    border-color: rgb(32, 184, 193);
}

.leaderboard-row--gold {
    background-color: rgb(255, 239, 196);
    border-color: rgb(218, 120, 38);
}

.leaderboard-row--silver {
    background-color: rgb(232, 236, 241);
    border-color: rgb(120, 132, 151);
}

.leaderboard-row--self {
    border-left-width: 8px;
    border-left-color: rgb(34, 126, 82);
}

.leaderboard-modal.is-loading .leaderboard-refresh {
    opacity: 0.55;
    scale: 0.92 0.92;
}

.leaderboard-modal.is-error .leaderboard-status {
    color: rgb(151, 54, 58);
}

