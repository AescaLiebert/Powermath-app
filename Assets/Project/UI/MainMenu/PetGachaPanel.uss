    min-width: 0;
    flex-grow: 1;
    overflow: visible;
}

.gacha-showcase-pet-wrap,
.gacha-showcase-pet {
    position: absolute;
    left: 0;
    top: -19px;
    width: 886px;
    height: 886px;
}

.gacha-showcase-pet {
    left: 0;
    top: 0;
    background-color: rgba(0, 0, 0, 0);
    transition-property: scale, opacity, translate;
    transition-duration: 0.28s;
    transition-timing-function: ease-out-back;
}

.pet-gacha-result--new .gacha-new-badge {
    background-color: var(--gacha-color-status-new);
}

.pet-gacha-result--duplicate .gacha-new-badge {
    background-color: var(--gacha-color-border-cream-deep);
}

.pet-gacha-result--duplicate .gacha-new-label {
    color: var(--gacha-color-text-navy);
    background-color: rgba(0, 0, 0, 0);
}

.pet-gacha-result--reveal .gacha-showcase-pet {
    scale: 1.06 1.06;
    translate: 0 -8px;
}

.gacha-screen--banner.is-reduced-motion .gacha-showcase-pet,
.gacha-screen--banner.is-reduced-motion .gacha-showcase-skip {
    transition-duration: 0s;
}
