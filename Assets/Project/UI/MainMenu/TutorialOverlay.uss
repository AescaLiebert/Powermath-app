.tutorial-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    opacity: 0;
}

.tutorial-overlay.is-visible {
    display: flex;
    opacity: 1;
}

.tutorial-overlay.is-reduced-motion,
.tutorial-overlay.is-reduced-motion * {
    transition-duration: 0.1s;
}

.tutorial-scrim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(4, 10, 24, 0.78);
}

.tutorial-focus-target {
    position: absolute;
    display: none;
    min-width: 72px;
    min-height: 72px;
    background-color: rgba(255, 255, 255, 0.04);
    border-left-width: 5px;
    border-right-width: 5px;
    border-top-width: 5px;
    border-bottom-width: 5px;
    border-left-color: rgb(255, 221, 72);
    border-right-color: rgb(255, 221, 72);
    border-top-color: rgb(255, 221, 72);
    border-bottom-color: rgb(255, 221, 72);
    border-top-left-radius: 28px;
    border-top-right-radius: 28px;
    border-bottom-left-radius: 28px;
    border-bottom-right-radius: 28px;
    transition-property: scale, border-left-color, border-right-color, border-top-color, border-bottom-color;
    transition-duration: 0.32s;
    transition-timing-function: ease-in-out;
}

.tutorial-focus-target.is-visible {
    display: flex;
}

.tutorial-focus-target.is-attention-pulse {
    scale: 1.09 1.09;
    background-color: rgba(255, 221, 72, 0.2);
    border-left-color: rgb(255, 247, 171);
    border-right-color: rgb(255, 247, 171);
    border-top-color: rgb(255, 247, 171);
    border-bottom-color: rgb(255, 247, 171);
}

.tutorial-focus-target:hover,
.tutorial-focus-target:focus {
    scale: 1.05 1.05;
    border-left-color: rgb(255, 246, 168);
    border-right-color: rgb(255, 246, 168);
    border-top-color: rgb(255, 246, 168);
    border-bottom-color: rgb(255, 246, 168);
}

.tutorial-dialogue {
    position: absolute;
    left: 5%;
    right: 5%;
    bottom: 4%;
    min-height: 180px;
    max-height: 42%;
    flex-direction: row;
    align-items: flex-end;
}

.tutorial-power {
    width: 230px;
    height: 230px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    opacity: 1;
    scale: 1 1;
    translate: 0 0;
    transition-property: opacity, scale, translate;
    transition-duration: 0.28s;
    transition-timing-function: ease-out-back;
}

.tutorial-power.is-emotion-entering {
    opacity: 0;
    scale: 0.86 0.86;
    translate: -18px 12px;
}

.tutorial-copy {
    flex-grow: 1;
    min-height: 154px;
    margin-left: 14px;
    padding-left: 26px;
    padding-right: 26px;
    padding-top: 18px;
    padding-bottom: 16px;
    background-color: rgba(250, 252, 255, 0.97);
    border-left-width: 4px;
    border-right-width: 4px;
    border-top-width: 4px;
    border-bottom-width: 4px;
    border-left-color: rgb(59, 117, 211);
    border-right-color: rgb(59, 117, 211);
    border-top-color: rgb(59, 117, 211);
    border-bottom-color: rgb(59, 117, 211);
    border-top-left-radius: 22px;
    border-top-right-radius: 22px;
    border-bottom-left-radius: 22px;
    border-bottom-right-radius: 22px;
}

.tutorial-speaker {
    color: rgb(26, 72, 148);
    font-size: 24px;
    -unity-font-style: bold;
}

.tutorial-body {
    flex-grow: 1;
    margin-top: 6px;
    color: rgb(20, 34, 59);
    font-size: 22px;
    white-space: normal;
}

.tutorial-advance {
    align-self: flex-end;
    min-width: 132px;
    min-height: 48px;
    margin-top: 8px;
    padding-left: 20px;
    padding-right: 20px;
    background-color: rgb(50, 111, 209);
    color: white;
    font-size: 18px;
    -unity-font-style: bold;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}

.tutorial-status {
    min-height: 20px;
    margin-top: 4px;
    color: rgb(143, 52, 44);
    font-size: 14px;
    white-space: normal;
}

.tutorial-overlay.is-narrow .tutorial-dialogue {
    left: 3%;
    right: 3%;
    bottom: 2%;
    min-height: 150px;
}

.tutorial-overlay.is-narrow .tutorial-power {
    width: 130px;
    height: 160px;
}

.tutorial-overlay.is-narrow .tutorial-copy {
    min-height: 140px;
    margin-left: 6px;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 12px;
    padding-bottom: 10px;
}

.tutorial-overlay.is-narrow .tutorial-speaker {
    font-size: 19px;
}

.tutorial-overlay.is-narrow .tutorial-body {
    font-size: 17px;
}
