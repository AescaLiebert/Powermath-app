.main-menu-root,
.main-menu-safe-area,
.main-shell,
.combat-layer {
    background-color: rgba(0, 0, 0, 0);
}

.main-menu-transition-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.main-menu-transition-layer.is-transition-blocking {
    display: flex;
}

.main-menu-transition-cover {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    opacity: 0;
    background-color: transparent;
    transition-property: opacity;
    transition-duration: 0.42s;
    transition-timing-function: ease-out;
}

.main-menu-transition-layer.is-bootstrap-active .main-menu-transition-cover {
    opacity: 1;
}

.main-menu-transition-layer.is-bootstrap-active .main-menu-transition-cover.is-scene-revealed,
.main-menu-transition-cover.is-scene-revealed {
    opacity: 0;
}

.battle-transition-square {
    position: absolute;
    width: 34%;
    height: 34%;
    background-color: rgb(13, 49, 94);
    transition-property: translate, opacity;
    transition-duration: 0.35s;
    transition-timing-function: ease-in-out-cubic;
}

.battle-transition-square--0, .battle-transition-square--3, .battle-transition-square--6 { left: 0; }
.battle-transition-square--1, .battle-transition-square--4, .battle-transition-square--7 { left: 33%; }
.battle-transition-square--2, .battle-transition-square--5, .battle-transition-square--8 { left: 66%; }
.battle-transition-square--0, .battle-transition-square--1, .battle-transition-square--2 { top: 0; }
.battle-transition-square--3, .battle-transition-square--4, .battle-transition-square--5 { top: 33%; }
.battle-transition-square--6, .battle-transition-square--7, .battle-transition-square--8 { top: 66%; }

.battle-transition-square.is-scene-revealed { opacity: 0; }
.battle-transition-square--0.is-scene-revealed,
.battle-transition-square--2.is-scene-revealed,
.battle-transition-square--4.is-scene-revealed,
.battle-transition-square--6.is-scene-revealed,
.battle-transition-square--8.is-scene-revealed { translate: -340% 0; }
.battle-transition-square--1.is-scene-revealed,
.battle-transition-square--3.is-scene-revealed,
.battle-transition-square--5.is-scene-revealed,
.battle-transition-square--7.is-scene-revealed { translate: 340% 0; }

.battle-start-title {
    min-width: 620px;
    padding: 8px 24px;
    opacity: 0;
    scale: 1.35 1.35;
    color: white;
    background-color: transparent;
    border-width: 0;
    font-size: 52px;
    letter-spacing: 4px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(8, 26, 54, 0.75);
    text-shadow: 0 4px 12px rgba(5, 12, 26, 0.75);
    transition-property: opacity, scale;
    transition-duration: 0.24s;
    transition-timing-function: ease-out-back;
}

.battle-start-title.is-visible {
    opacity: 1;
    scale: 1 1;
}

.battle-start-accent {
    position: absolute;
    width: 48%;
    height: 18px;
    opacity: 0;
    display: none;
    background-color: rgb(67, 180, 226);
    border-top-width: 4px;
    border-bottom-width: 4px;
    border-color: rgb(255, 207, 79);
    transition-property: translate, opacity;
    transition-duration: 0.24s;
    transition-timing-function: ease-out-back;
}

.battle-start-accent--left {
    left: -50%;
    translate: -80px 0;
}

.battle-start-accent--right {
    right: -50%;
    translate: 80px 0;
}

.battle-start-accent--left.is-visible {
    opacity: 0.9;
    translate: 58% 0;
}

.battle-start-accent--right.is-visible {
    opacity: 0.9;
    translate: -58% 0;
}

.main-menu-root.is-reduced-motion .battle-start-title,
.main-menu-root.is-reduced-motion .battle-start-accent {
    transition-duration: 0.12s;
}

.main-menu-root.is-reduced-motion .battle-start-title,
.main-menu-root.is-reduced-motion .battle-start-title.is-visible {
    scale: 1 1;
}

.main-menu-root.is-reduced-motion .battle-start-accent {
    display: none;
}

.main-menu-root.is-reduced-motion .battle-transition-square {
    transition-duration: 0.20s;
    translate: 0 0;
}

.main-menu-safe-area,
.main-shell {
    overflow: hidden;
}

.main-menu-root {
    --figma-cream: rgb(255, 248, 235);
    --figma-navy: rgb(18, 57, 107);
    --figma-slate: rgb(155, 178, 200);
    --figma-divider: rgb(215, 199, 174);
    --figma-blue-soft: rgb(234, 242, 248);
    --figma-blue: rgb(43, 108, 176);
    --figma-red: rgb(255, 83, 83);
    --figma-shadow: rgba(10, 36, 61, 0.2);
    --stage-info-surface: rgba(255, 248, 235, 0.94);
    --stage-info-outline: rgba(155, 178, 200, 0.95);
    --stage-info-track: rgba(245, 240, 233, 0.2);
    --stage-info-fill: rgb(214, 34, 45);
    --stage-info-fill-dark: rgb(155, 11, 13);
    --boss-hp-fill-base: rgb(255, 178, 179);
    --boss-hp-gradient-dark: rgb(163, 0, 3);
    --boss-hp-gradient-middle: rgb(230, 48, 51);
    --boss-hp-gradient-light: rgb(239, 78, 81);
    --stage-info-ability-shadow: rgb(111, 133, 154);
    --stage-info-grid-gap: 8px;
}

.figma-object-name {
    position: absolute;
    width: 0;
    height: 0;
}

.main-shell {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    color: rgb(244, 248, 255);
}

.hud-compat-hidden {
    display: none;
}

.hud-profile-panel-shadow {
    position: absolute;
    left: 25px;
    top: 26px;
    width: 448px;
    height: 120px;
    --figma-shadow-color: var(--figma-shadow);
    --figma-shadow-offset-x: 0;
    --figma-shadow-offset-y: 8;
    --figma-shadow-blur: 18;
    --figma-shadow-spread: 0;
    --figma-shadow-radius: 34;
}

.hud-profile-panel {
    position: absolute;
    left: 25px;
    top: 26px;
    width: 448px;
    height: 120px;
    padding: 5px 10px;
    flex-direction: row;
    align-items: flex-end;
    justify-content: flex-start;
    background-color: var(--figma-cream);
    border-radius: 34px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-color: var(--figma-slate);
    overflow: visible;
    transition-property: scale, border-color;
    transition-duration: 0.16s;
    transition-timing-function: ease-out-back;
}

.hud-profile-panel:hover,
.hud-profile-panel:focus {
    scale: 1.03 1.03;
    translate: 0 -2px;
    border-color: rgb(255, 207, 91);
}

.hud-profile-panel:active {
    scale: 0.96 0.96;
    translate: 0 1px;
    transition-duration: 0.08s;
}

.hud-profile-icon {
    position: relative;
    width: 106px;
    height: 106px;
    min-width: 106px;
    min-height: 106px;
    flex-grow: 0;
    flex-shrink: 0;
    margin: 0;
    overflow: hidden;
    border-radius: 16px;
}

.hud-profile-frame {
    position: absolute;
    left: 0;
    top: 0;
    width: 106px;
    height: 106px;
    background-color: rgb(221, 238, 255);
    border-width: 4px;
    border-color: rgb(233, 185, 92);
    border-radius: 16px;
}

.hud-profile-avatar {
    position: absolute;
    left: 4px;
    top: 4px;
    width: 98px;
    height: 98px;
    background-color: rgb(221, 238, 255);
    border-width: 2px;
    border-color: rgb(233, 185, 92);
    border-radius: 12px;
    overflow: hidden;
}

.hud-profile-picture {
    position: absolute;
    left: 4px;
    top: 4px;
    width: 98px;
    height: 98px;
    background-image: url("project://database/Assets/Project/Art/Character/PFP_Ricko_1.png?fileID=-308810356698134934&guid=dcb3aa4df8f06ce4596356c530659994&type=3#PFP_Ricko_1_0");
    -unity-background-scale-mode: scale-and-crop;
    border-radius: 12px;
    overflow: hidden;
}

.hud-profile-copy {
    position: relative;
    width: 320px;
    height: 91px;
    min-width: 320px;
    min-height: 91px;
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
}

.hud-profile-name {
    width: 306px;
    height: 34px;
    min-height: 34px;
    margin: 0 0 0 14px;
    padding: 0;
    flex-grow: 0;
    flex-shrink: 0;
    color: var(--figma-navy);
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
