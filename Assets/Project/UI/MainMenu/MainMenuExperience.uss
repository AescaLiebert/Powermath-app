.hud-loadout-slot--large {
    width: 126px;
    height: 143px;
}

.hud-loadout-slot--small {
    width: 100px;
    height: 132px;
}

.hud-loadout-slot-shadow {
    position: absolute;
    left: 0;
    top: 0;
    --figma-shadow-color: var(--loadout-slot-shadow);
    --figma-shadow-offset-x: 0;
    --figma-shadow-offset-y: 4;
    --figma-shadow-blur: 8;
    --figma-shadow-spread: 0;
    --figma-shadow-radius: 18;
}

.hud-loadout-slot-shadow--large {
    width: 126px;
    height: 143px;
}

.hud-loadout-slot-shadow--small {
    width: 100px;
    height: 132px;
}

.hud-loadout-slot-gradient {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-radius: 16px;
    --figma-gradient-radius: 16;
    --figma-gradient-stop-count: 3;
    --figma-gradient-color-0: var(--loadout-slot-fill-0);
    --figma-gradient-stop-0: 0;
    --figma-gradient-color-1: var(--loadout-slot-fill-1);
    --figma-gradient-stop-1: 0.58;
    --figma-gradient-color-2: var(--loadout-slot-fill-2);
    --figma-gradient-stop-2: 1;
    --figma-gradient-start-x: 0;
    --figma-gradient-start-y: 0.08;
    --figma-gradient-end-x: 0.84;
    --figma-gradient-end-y: -0.08;
}

.hud-loadout-slot-border {
    position: absolute;
    left: 1px;
    top: 1px;
    background-color: rgba(255, 247, 234, 0.1);
    border-left-width: 1.5px;
    border-right-width: 1.5px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(225, 207, 183, 0.75);
    border-right-color: rgba(225, 207, 183, 0.75);
    border-top-color: rgba(255, 255, 255, 0.82);
    border-bottom-color: rgba(181, 141, 100, 0.16);
    border-radius: 15px;
}

.hud-loadout-slot-border--large {
    width: 120px;
    height: 137px;
}

.hud-loadout-slot-border--weapon {
    top: 2px;
    height: 136px;
}

.hud-loadout-slot-border--small {
    width: 94px;
    height: 126px;
}

.hud-loadout-artwork {
    position: absolute;
    left: 3.5px;
    top: 3px;
    width: 115px;
    height: 104px;
}

.hud-loadout-watermark {
    position: absolute;
    width: 48.6px;
    height: 48.6px;
    -unity-background-scale-mode: scale-to-fit;
}

.hud-loadout-watermark--pet {
    left: 28.5px;
    top: 22.7px;
    background-image: url("project://database/Assets/Project/Art/UI/Icon/Icon_title_pet.png?fileID=6674195197632703334&guid=1b2e391e263824a498bd75fc33eae64a&type=3#Icon_title_pet_0");
}

.hud-loadout-watermark--weapon {
    left: 28px;
    top: 16.7px;
    background-image: url("project://database/Assets/Project/Art/UI/Icon/Player_title_sword.png?fileID=2585870654315560641&guid=3aefe66a41532574680663ae25a71d04&type=3#Player_title_sword_0");
}

.hud-loadout-star-frame {
    position: absolute;
    left: 37.5px;
    top: 117px;
    width: 47px;
    height: 19px;
    padding: 0 14px;
    flex-direction: row;
}

.hud-loadout-star {
    width: 19px;
    height: 19px;
    background-image: url("project://database/Assets/Project/Art/UI/Icon/Generic_Star.png?fileID=-3701803639222355071&guid=3b4a2a288ce72154cafb0fc1c6f508d5&type=3#Generic_Star_0");
    -unity-background-scale-mode: scale-to-fit;
}

.hud-loadout-unavailable {
    position: absolute;
    left: -8px;
    top: -10px;
    width: 112px;
    height: 149px;
    background-color: rgba(0, 0, 0, 0.49);
    border-radius: 15px;
}

.combat-attempt-panel {
    left: 50%;
    right: auto;
    margin-left: -230px;
    margin-right: 0;
    top: 7%;
    bottom: 7%;
    transition-property: opacity, scale, translate, left, right, margin-left;
    transition-duration: 220ms;
    transition-timing-function: ease-out-back;
}

.combat-attempt-panel.combat-attempt-panel--retained-video {
    left: 49%;
    right: 5%;
    margin-left: 0;
    margin-right: 0;
}

.combat-attempt-panel.combat-attempt-panel--retained-video-narrow {
    left: 12px;
    right: 12px;
    top: 44%;
    bottom: 12px;
    width: auto;
    max-width: none;
    margin-left: 0;
    margin-right: 0;
}

.navigator-modal {
    top: 0;
}

.navigator-card {
    width: 980px;
    max-width: 88%;
    height: 800px;
    max-height: 84%;
}

.combat-map-node--current {
    border-left-width: 8px;
    border-left-color: rgb(244, 111, 83);
}

.reward-magnet-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.reward-magnet-icon {
    position: absolute;
    width: 36px;
    height: 36px;
    -unity-background-scale-mode: scale-to-fit;
}

.reward-magnet-icon--silver {
    background-image: url("project://database/Assets/Project/Art/UI/Icon/coin_sliver.png?fileID=-8422487062728157231&guid=ac63900fe97682a4bac070effc08d269&type=3#coin_sliver_0");
}

.reward-magnet-icon--gold {
    background-image: url("project://database/Assets/Project/Art/UI/Icon/coin_gold.png?fileID=4793385847135534003&guid=7ac6778b768ae6b4792baa5619425848&type=3#coin_gold_1");
}

.reward-magnet-icon--diamond {
    background-image: url("project://database/Assets/Project/Art/UI/Icon/coin_diamond.png?fileID=6309500834797410919&guid=5452206884f11c442b7cedd0f4e9962d&type=3#coin_diamond_0");
}

.reward-magnet-icon--coin {
    background-image: url("project://database/Assets/Project/Art/UI/Icon/coin_power.png?fileID=-6225944553927798696&guid=0293b2c42305b784eb70f1ca658d2b92&type=3#coin_power_1");
}
