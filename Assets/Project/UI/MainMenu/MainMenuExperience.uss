}

.hud-navigator {
    --navigator-fill: rgba(255, 247, 224, 0.94);
    --navigator-fill-solid: rgb(255, 247, 224);
    --navigator-stroke: rgb(224, 179, 102);
    --navigator-shadow: rgba(10, 41, 71, 0.24);
    position: absolute;
    right: 39px;
    top: 28px;
    width: 239px;
    height: 79px;
    padding: 0;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    background-color: transparent;
    border-width: 0;
}

.hud-icon-button-shadow {
    position: absolute;
    top: 10.5px;
    width: 58px;
    height: 58px;
    --figma-shadow-color: var(--navigator-shadow);
    --figma-shadow-offset-x: 0;
    --figma-shadow-offset-y: 6;
    --figma-shadow-blur: 10;
    --figma-shadow-spread: 0;
    --figma-shadow-radius: 29;
}

.hud-icon-button-shadow--biome {
    left: 0;
}

.hud-icon-button-shadow--leaderboard {
    left: 86px;
}

.hud-icon-button-shadow--settings {
    left: 172px;
}

.hud-icon-button {
    min-width: 58px;
    width: 58px;
    min-height: 58px;
    height: 58px;
    margin: 0;
    padding: 0;
    color: var(--figma-navy);
    background-color: var(--navigator-fill);
    border-radius: 29px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-color: var(--navigator-stroke);
    -unity-background-scale-mode: scale-to-fit;
    transition-property: scale, translate, background-color, border-color;
    transition-duration: 0.16s;
    transition-timing-function: ease-out-back;
}

.hud-icon-button--biome {
    margin-right: 28px;
    background-image: url("project://database/Assets/Project/Art/UI/Icon/Icon_stage.png?fileID=-7899887828367425398&guid=d13800569fa011f4aa1e471cd01717a6&type=3#Icon_stage_0");
}

.hud-icon-button--leaderboard {
    margin-right: 28px;
    background-image: url("project://database/Assets/Project/Art/UI/Icon/MW-Leaderboard-Crown.png?fileID=7559708126212142998&guid=82635050b33e8994fbbfd49247ab5d76&type=3#MW-Leaderboard-Crown_0");
}

.hud-icon-button--settings {
    background-color: var(--navigator-fill-solid);
}

.hud-icon-button:hover,
.hud-icon-button:focus {
    background-color: rgb(255, 251, 238);
    border-color: rgb(240, 188, 83);
    scale: 1.06 1.06;
    translate: 0 -2px;
}

.hud-icon-button:active {
    scale: 0.92 0.92;
    translate: 0 2px;
    transition-duration: 0.08s;
}

.hud-icon-button:disabled {
    opacity: 0.72;
    scale: 1 1;
    translate: 0 0;
}

.hud-icon-button.is-feature-locked {
    opacity: 0.85;
    scale: 1 1;
    translate: 0 0;
}

.hud-icon-button.is-feature-locked:hover,
.hud-icon-button.is-feature-locked:focus,
.hud-icon-button.is-feature-locked:active {
    scale: 1 1;
    translate: 0 0;
    background-color: var(--navigator-fill);
    border-color: var(--navigator-stroke);
}

.hud-player-menu {
    --player-menu-fill: rgba(255, 248, 235, 0.94);
    --player-menu-stroke: rgba(155, 178, 200, 0.95);
    --player-menu-shadow-color: rgba(10, 36, 61, 0.2);
    --player-card-outer-fill: rgb(251, 233, 198);
    --player-card-outer-stroke: rgb(165, 185, 180);
    --player-card-fill-start: rgb(247, 240, 227);
    --player-card-fill-end: rgb(255, 241, 215);
    --player-card-detail-stroke: rgba(67, 48, 20, 0.3);
    --power-coin-field-fill: rgba(234, 242, 248, 0.96);
    --power-coin-field-stroke: rgb(134, 134, 134);
    --power-coin-field-shadow: rgba(0, 0, 0, 0.25);
    position: absolute;
    left: 29px;
    top: 254px;
    width: 294px;
    height: 509px;
    align-items: flex-start;
    overflow: visible;
}

.hud-player-menu-shadow {
    position: absolute;
    left: 0;
    top: 0;
    width: 210px;
    height: 509px;
    --figma-shadow-color: var(--player-menu-shadow-color);
    --figma-shadow-offset-x: 0;
    --figma-shadow-offset-y: 8;
    --figma-shadow-blur: 18;
    --figma-shadow-spread: 0;
    --figma-shadow-radius: 30;
    opacity: 1;
    translate: 0 0;
    transition-property: translate, opacity;
    transition-duration: 0.11s;
    transition-timing-function: ease-out;
}

.hud-player-menu-toggle {
    position: absolute;
    left: 252px;
    top: 298.5px;
    min-width: 42px;
    width: 42px;
    min-height: 88px;
    height: 88px;
    margin: 0;
    padding: 0;
    color: rgb(18, 57, 107);
    background-color: rgba(237, 245, 251, 0.96);
    border-radius: 0 18px 18px 0;
    border-width: 2px;
    border-color: rgb(155, 178, 200);
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-property: scale, translate, background-color, border-color;
    transition-duration: 0.11s;
    transition-timing-function: ease-out;
}

.hud-player-menu-toggle:hover,
.hud-player-menu-toggle:focus {
    scale: 1.04 1.04;
    translate: 1px 0;
    background-color: rgb(247, 251, 255);
    border-color: rgb(224, 179, 102);
}

.hud-player-menu-toggle:active {
    scale: 0.94 0.94;
    transition-duration: 0.08s;
}

.hud-player-menu-chevron {
    position: absolute;
    left: 12px;
    top: 24px;
    width: 10px;
    height: 39px;
    margin: 0;
    padding: 0;
    color: rgb(18, 57, 107);
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    overflow: visible;
}

.hud-player-menu-content {
    width: 210px;
    height: 509px;
    padding: 22px 24px;
    align-items: center;
    justify-content: flex-start;
    background-color: var(--player-menu-fill);
    border-radius: 30px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-color: var(--player-menu-stroke);
    transition-property: translate, opacity, scale;
    opacity: 1;
    translate: 0 0;
    transition-duration: 0.11s;
    transition-timing-function: ease-out;
}

.hud-player-menu-content.is-follow-through,
.hud-player-menu-shadow.is-follow-through {
    translate: 12px 0;
    transition-duration: 0.26s;
    transition-timing-function: ease-out-back;
}

.hud-player-menu-toggle.is-follow-through {
    translate: 8px 0;
    transition-duration: 0.26s;
    transition-timing-function: ease-out-back;
}

.hud-player-menu-content.is-collapsed,
.hud-player-menu-shadow.is-collapsed {
    translate: -239px 0;
    opacity: 0;
    transition-duration: 0.22s;
    transition-timing-function: ease-in-back;
}

.hud-player-menu-toggle.is-collapsed {
    translate: -230px 0;
    transition-duration: 0.22s;
    transition-timing-function: ease-in-back;
}

.main-menu-root.is-reduced-motion .hud-player-menu-content,
.main-menu-root.is-reduced-motion .hud-player-menu-shadow,
.main-menu-root.is-reduced-motion .hud-player-menu-toggle {
    transition-duration: 0s;
}

