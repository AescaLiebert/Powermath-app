    background-color: var(--figma-blue-soft);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 4px;
    border-left-color: var(--figma-slate);
    border-right-color: var(--figma-slate);
    border-top-color: white;
    border-bottom-color: var(--stage-info-ability-shadow);
    border-radius: 14px;
    font-size: 15px;
    -unity-font-style: bold;
}

.figma-grid-gap-right {
    margin-right: var(--stage-info-grid-gap);
}

.figma-ability--attack {
    color: rgb(176, 43, 45);
    background-color: var(--figma-red);
    border-left-color: rgb(87, 34, 35);
    border-right-color: rgb(87, 34, 35);
    border-top-color: rgb(255, 164, 164);
    border-bottom-color: rgb(87, 34, 35);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(255, 255, 255, 0.85);
}

.hud-encounter-panel {
