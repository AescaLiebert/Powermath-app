    --figma-shadow-color: var(--stage-info-fill-dark);
    --figma-shadow-offset-y: 1;
    --figma-shadow-radius: 10;
}

.figma-boss-fill-gradient {
    position: absolute;
    left: 0;
    right: 0;
    top: 1px;
    height: 27px;
    overflow: hidden;
    border-radius: 10px;
    --figma-gradient-stop-count: 3;
