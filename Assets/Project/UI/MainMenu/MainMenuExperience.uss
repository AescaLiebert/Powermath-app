.main-menu-root,
.main-menu-safe-area,
.main-shell,
.combat-layer {
    background-color: rgba(0, 0, 0, 0);
}

.main-menu-transition-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    z-index: 500;
}

.main-menu-transition-layer.is-transition-blocking {
    display: flex;
}

.main-menu-transition-cover {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    opacity: 0;
    background-color: rgb(8, 20, 42);
    transition-property: opacity;
    transition-duration: 0.42s;
    transition-timing-function: ease-out;
}

.main-menu-transition-layer.is-bootstrap-active .main-menu-transition-cover {
    opacity: 1;
}

.main-menu-transition-layer.is-bootstrap-active .main-menu-transition-cover.is-scene-revealed,
.main-menu-transition-cover.is-scene-revealed {
    opacity: 0;
}

.battle-start-title {
    min-width: 720px;
    padding: 20px 64px;
    opacity: 0;
    scale: 1.35 1.35;
    color: rgb(255, 244, 198);
    background-color: rgba(13, 49, 94, 0.96);
    border-width: 4px;
    border-color: rgb(255, 194, 64);
    border-radius: 22px;
    font-size: 78px;
    letter-spacing: 8px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(8, 26, 54);
    transition-property: opacity, scale;
    transition-duration: 0.24s;
    transition-timing-function: ease-out-back;
}

.battle-start-title.is-visible {
    opacity: 1;
    scale: 1 1;
}

.battle-start-accent {
    position: absolute;
    width: 48%;
    height: 18px;
    opacity: 0;
    background-color: rgb(67, 180, 226);
    border-top-width: 4px;
    border-bottom-width: 4px;
    border-color: rgb(255, 207, 79);
    transition-property: translate, opacity;
    transition-duration: 0.24s;
    transition-timing-function: ease-out-back;
}

.battle-start-accent--left {
    left: -50%;
    translate: -80px 0;
}

.battle-start-accent--right {
    right: -50%;
    translate: 80px 0;
}

.battle-start-accent--left.is-visible {
    opacity: 0.9;
    translate: 58% 0;
}

.battle-start-accent--right.is-visible {
    opacity: 0.9;
    translate: -58% 0;
}

.main-menu-root.is-reduced-motion .battle-start-title,
.main-menu-root.is-reduced-motion .battle-start-accent {
    transition-duration: 0.12s;
}

.main-menu-root.is-reduced-motion .battle-start-title,
.main-menu-root.is-reduced-motion .battle-start-title.is-visible {
    scale: 1 1;
}

.main-menu-root.is-reduced-motion .battle-start-accent {
    display: none;
}

.main-menu-safe-area,
.main-shell {
    overflow: hidden;
}

.main-shell {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    color: rgb(244, 248, 255);
}

.hud-compat-hidden {
    display: none;
}

.hud-profile-panel {
    position: absolute;
    left: 28px;
    top: 24px;
    width: 420px;
    height: 112px;
    padding: 12px 20px 12px 12px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(19, 46, 87, 0.94);
    border-radius: 56px 24px 24px 56px;
    border-width: 2px;
    border-color: rgba(205, 228, 255, 0.58);
    transition-property: scale, border-color;
    transition-duration: 0.16s;
    transition-timing-function: ease-out-back;
}

.hud-profile-panel:hover,
.hud-profile-panel:focus {
    scale: 1.03 1.03;
    translate: 0 -2px;
    border-color: rgb(255, 207, 91);
}

.hud-profile-panel:active {
    scale: 0.96 0.96;
    translate: 0 1px;
    transition-duration: 0.08s;
}

.hud-profile-icon {
    width: 84px;
    height: 84px;
    margin-right: 15px;
    align-items: center;
    justify-content: center;
    color: white;
    background-color: rgb(53, 116, 186);
    border-radius: 42px;
    border-width: 4px;
    border-color: rgb(220, 234, 251);
    font-size: 36px;
    -unity-font-style: bold;
}

.hud-profile-copy {
    flex-grow: 1;
    min-width: 0;
}

.hud-profile-name {
    padding-bottom: 8px;
    color: white;
    font-size: 24px;
    -unity-font-style: bold;
    border-bottom-width: 1px;
    border-bottom-color: rgba(211, 228, 250, 0.5);
    white-space: nowrap;
}

.hud-rank-currencies,
.hud-rank-currency {
    flex-direction: row;
    align-items: center;
}

.hud-rank-currencies {
    margin-top: 8px;
}

.hud-rank-currency {
    min-width: 78px;
    margin-right: 8px;
    color: white;
    font-size: 17px;
    -unity-font-style: bold;
}

.hud-rank-icon {
    width: 25px;
    height: 25px;
    margin-right: 6px;
    align-items: center;
    justify-content: center;
    border-radius: 13px;
    color: rgb(20, 39, 67);
    font-size: 13px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.hud-rank-icon--silver { background-color: rgb(194, 208, 226); }
.hud-rank-icon--gold { background-color: rgb(255, 198, 65); }
.hud-rank-icon--diamond { background-color: rgb(105, 223, 242); }

.hud-navigator {
    position: absolute;
    right: 26px;
    top: 24px;
    height: 76px;
    padding: 7px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(18, 52, 94, 0.9);
    border-radius: 38px;
    border-width: 2px;
    border-color: rgba(204, 230, 255, 0.55);
}

.hud-icon-button {
    min-width: 58px;
    width: 58px;
    min-height: 58px;
    height: 58px;
    margin: 0 4px;
    padding: 0;
    color: white;
    background-color: rgb(45, 105, 166);
    border-radius: 29px;
    border-width: 2px;
    border-color: rgba(211, 232, 255, 0.7);
    font-size: 29px;
    -unity-font-style: bold;
    transition-property: scale, translate, background-color, border-color;
    transition-duration: 0.16s;
    transition-timing-function: ease-out-back;
}

.hud-icon-button:hover,
.hud-icon-button:focus {
    background-color: rgb(63, 140, 205);
    border-color: rgb(255, 215, 102);
    scale: 1.10 1.10;
    translate: 0 -3px;
}

.hud-icon-button:active {
    scale: 0.92 0.92;
    translate: 0 2px;
    transition-duration: 0.08s;
}

.hud-icon-button:disabled {
    opacity: 0.72;
    scale: 1 1;
    translate: 0 0;
}

.hud-player-menu {
    position: absolute;
    left: 28px;
    top: 295px;
    width: 148px;
    min-height: 405px;
    align-items: flex-start;
}

.hud-player-menu-toggle {
    position: absolute;
    right: -23px;
    top: 54px;
    min-width: 40px;
    width: 40px;
    height: 68px;
    padding: 0;
    color: white;
    background-color: rgba(18, 52, 94, 0.96);
    border-radius: 0 18px 18px 0;
    border-width: 2px;
    border-left-width: 0;
    border-color: rgba(207, 229, 255, 0.68);
    font-size: 31px;
    -unity-font-style: bold;
    transition-property: scale, translate, background-color, border-color;
    transition-duration: 0.16s;
    transition-timing-function: ease-out-back;
}

.hud-player-menu-toggle:hover,
.hud-player-menu-toggle:focus {
    scale: 1.06 1.06;
    translate: 2px 0;
    background-color: rgb(25, 70, 125);
    border-color: rgb(255, 215, 102);
}

.hud-player-menu-toggle:active {
    scale: 0.94 0.94;
    transition-duration: 0.08s;
}

.hud-player-menu-content {
    width: 132px;
    padding: 9px;
    align-items: center;
    background-color: rgba(18, 52, 94, 0.93);
    border-radius: 22px;
    border-width: 2px;
    border-color: rgba(207, 229, 255, 0.68);
    transition-property: translate, opacity, scale;
    transition-duration: 0.18s;
    transition-timing-function: ease-out-back;
}

.hud-player-menu-content.is-collapsed {
    display: none;
}

.hud-player-resources {
    width: 100%;
    margin-bottom: 5px;
}

.hud-player-resource {
    width: 100%;
    height: 36px;
    margin-bottom: 5px;
    padding: 4px 8px;
    flex-direction: row;
    align-items: center;
    color: rgb(28, 47, 74);
    background-color: rgba(255, 250, 235, 0.96);
    border-radius: 18px;
    font-size: 16px;
    -unity-font-style: bold;
}

.hud-player-resource-icon {
    width: 24px;
    margin-right: 8px;
    font-size: 18px;
    -unity-text-align: middle-center;
}

.hud-player-resource-icon--coin { color: rgb(224, 156, 31); }
.hud-player-resource-icon--attack { color: rgb(61, 126, 188); }

.hud-player-menu-button {
    min-width: 96px;
    width: 96px;
    min-height: 82px;
    height: 82px;
    margin: 5px 0;
    padding: 0;
    color: rgb(27, 53, 86);
    background-color: rgba(255, 251, 241, 0.98);
    border-radius: 18px;
    border-width: 3px;
    border-color: rgb(184, 211, 234);
    font-size: 42px;
    -unity-font-style: bold;
    transition-property: scale, translate, background-color, border-color;
    transition-duration: 0.16s;
    transition-timing-function: ease-out-back;
}

.hud-player-menu-button:hover,
.hud-player-menu-button:focus {
    border-color: rgb(255, 194, 64);
    background-color: white;
    scale: 1.06 1.06;
    translate: 0 -2px;
}

.hud-player-menu-button:active {
    scale: 0.93 0.93;
    translate: 0 2px;
    transition-duration: 0.08s;
}

.hud-player-menu-button:disabled {
    opacity: 0.5;
    scale: 1 1;
    translate: 0 0;
}

.hud-player-menu-button--rebirth {
    color: rgb(194, 55, 108);
    border-color: rgb(246, 171, 195);
}

.hud-player-menu-button--rebirth:hover,
.hud-player-menu-button--rebirth:focus {
    border-color: rgb(244, 111, 83);
    background-color: rgb(255, 242, 245);
    color: rgb(218, 38, 96);
    scale: 1.06 1.06;
    translate: 0 -2px;
}

.hud-player-menu-button--rebirth:active {
    scale: 0.93 0.93;
    translate: 0 2px;
    transition-duration: 0.08s;
}

.hud-player-menu-button--rebirth.is-ready {
    border-color: rgb(244, 111, 83);
    background-color: rgb(255, 243, 237);
    color: rgb(218, 38, 96);
}

.hud-session-status {
    position: absolute;
    left: 30px;
    top: 146px;
    width: 410px;
}

.combat-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding: 0;
    align-items: stretch;
    justify-content: flex-start;
}

.hud-encounter-panel {
    position: absolute;
    left: 33%;
    right: 33%;
    top: 20px;
    min-width: 510px;
    min-height: 154px;
    padding: 12px 16px 14px;
    color: white;
    background-color: rgba(17, 50, 91, 0.9);
    border-radius: 22px;
    border-width: 2px;
    border-color: rgba(206, 229, 252, 0.68);
}

.hud-stage-label {
    align-self: center;
    min-width: 190px;
    height: 42px;
    padding: 7px 24px;
    color: white;
    background-color: rgb(19, 45, 79);
    border-radius: 21px;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.hud-enemy-hp-shell {
    position: relative;
    width: 100%;
    height: 28px;
    margin-top: 8px;
}

.hud-enemy-hp-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding: 0 10px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.hud-enemy-name,
.hud-enemy-hp-label {
    color: white;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(11, 26, 48, 0.92);
}

.hud-enemy-hp {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: auto;
    height: auto;
    margin: 0;
}

.hud-enemy-hp .unity-progress-bar__background {
    background-color: rgba(52, 22, 36, 0.88);
}

.hud-enemy-hp .unity-progress-bar__progress {
    background-color: rgb(239, 83, 97);
}

.hud-enemy-actions {
    height: 42px;
    margin-top: 8px;
    flex-direction: row;
    align-items: center;
}

.hud-enemy-action {
    width: 50px;
    height: 38px;
    margin-right: 7px;
    align-items: center;
    justify-content: center;
    color: rgb(214, 232, 250);
    background-color: rgba(16, 38, 68, 0.96);
    border-radius: 11px;
    border-width: 2px;
    border-color: rgba(169, 203, 234, 0.65);
    font-size: 19px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.hud-enemy-action--spent {
    opacity: 0.28;
    background-color: rgba(13, 25, 43, 0.8);
}

.hud-enemy-action--attack {
    color: white;
    background-color: rgb(190, 58, 62);
    border-color: rgb(255, 173, 107);
}

.hud-enemy-action--danger {
    scale: 1.08 1.08;
    background-color: rgb(224, 60, 62);
}

.hud-enemy-action--entering {
    opacity: 0;
    scale: 0.72 0.72;
}

.hud-enemy-action--armed {
    border-color: rgb(255, 226, 112);
    scale: 1.10 1.10;
}

.hud-enemy-action--consuming {
    opacity: 0;
    scale: 1.30 0.55;
    translate: 0 -10px;
}

.hud-enemy-action--cancelled {
    opacity: 0;
    scale: 0.60 0.60;
    translate: 0 8px;
}

.hud-enemy-action,
.hud-enemy-action--reflowing {
    transition-property: translate, scale, opacity, border-color;
    transition-duration: 160ms;
    transition-timing-function: ease-out-back;
}

.main-menu-interaction-shield {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.01);
}

.ui-lifecycle--entering {
    opacity: 0;
    scale: 0.90 0.90;
    translate: 0 12px;
}

.ui-lifecycle--exiting {
    opacity: 0;
    scale: 0.96 0.96;
    translate: 0 -6px;
}

.combat-attempt-panel,
.combat-feedback-card,
.combat-battle-banner,
.run-settlement-modal {
    transition-property: opacity, scale, translate;
    transition-duration: 220ms;
    transition-timing-function: ease-out-back;
}

.combat-biome-transition {
    transition-property: opacity;
    transition-duration: 350ms;
    transition-timing-function: ease-out;
}

.combat-biome-transition-card {
    transition-property: opacity, scale, translate;
    transition-duration: 450ms;
    transition-timing-function: ease-out-back;
}

.combat-biome-transition.ui-lifecycle--entering .combat-biome-transition-card {
    opacity: 0;
    scale: 0.72 0.72;
    translate: 0 32px;
}

.combat-biome-transition.ui-lifecycle--exiting .combat-biome-transition-card {
    opacity: 0;
    scale: 1.08 1.08;
    translate: 0 -16px;
    transition-duration: 320ms;
    transition-timing-function: ease-in-cubic;
}

.hud-attack-button {
    position: absolute;
    left: 31%;
    bottom: 205px;
    min-width: 88px;
    width: 88px;
    min-height: 88px;
    height: 88px;
    padding: 0;
    color: white;
    background-color: rgb(35, 103, 185);
    border-radius: 44px;
    border-width: 4px;
    border-color: rgb(255, 207, 75);
    font-size: 42px;
    -unity-font-style: bold;
    transition-property: scale, translate, background-color, border-color;
    transition-duration: 0.16s;
    transition-timing-function: ease-out-back;
}

.hud-attack-button:hover,
.hud-attack-button:focus {
    scale: 1.10 1.10;
    translate: 0 -4px;
    background-color: rgb(48, 132, 210);
    border-color: rgb(255, 226, 112);
}

.hud-attack-button:active {
    scale: 0.92 0.92;
    translate: 0 2px;
    transition-duration: 0.08s;
}

.hud-attack-button:disabled {
    opacity: 0.65;
    scale: 1 1;
    translate: 0 0;
}

.hud-dashboard {
    position: absolute;
    right: 28px;
    bottom: 22px;
    width: 820px;
    min-height: 176px;
    padding: 12px;
    background-color: rgba(19, 51, 91, 0.93);
    border-radius: 24px;
    border-width: 2px;
    border-color: rgba(207, 229, 255, 0.68);
}

.hud-health-row {
    height: 46px;
    padding: 6px 16px;
    flex-direction: row;
    align-items: center;
    color: rgb(25, 62, 94);
    background-color: rgba(250, 252, 250, 0.98);
    border-radius: 18px;
}

.hud-health-icon {
    margin-right: 12px;
    color: rgb(230, 69, 86);
    font-size: 28px;
}

.hud-health-value {
    color: rgb(202, 52, 74);
    font-size: 20px;
    -unity-font-style: bold;
}

.hud-dashboard-slots {
    margin-top: 9px;
    flex-direction: row;
    justify-content: space-between;
}

.hud-dashboard-slot {
    width: 146px;
    height: 92px;
    padding: 8px;
    align-items: center;
    justify-content: center;
    color: rgb(27, 54, 87);
    background-color: rgba(255, 252, 244, 0.98);
    border-radius: 15px;
    border-width: 3px;
    border-color: rgb(190, 214, 236);
}

.hud-dashboard-slot--rank {
    color: white;
    background-color: rgb(54, 116, 181);
    border-color: rgb(120, 201, 235);
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.hud-slot-caption {
    color: rgb(87, 111, 139);
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.hud-slot-value {
    margin-top: 7px;
    color: rgb(29, 54, 87);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.hud-dashboard-slot--locked {
    opacity: 0.56;
}

.combat-attempt-panel {
    left: 24%;
    right: 24%;
    top: 7%;
    bottom: 7%;
    z-index: 100;
    transition-property: left, right;
    transition-duration: 0.18s;
}

.combat-attempt-panel.combat-attempt-panel--retained-video {
    left: 49%;
    right: 5%;
}

.navigator-modal {
    top: 0;
    z-index: 120;
}

.navigator-card {
    width: 980px;
    max-width: 88%;
    height: 800px;
    max-height: 84%;
}

.combat-map-node--current {
    border-left-width: 8px;
    border-left-color: rgb(244, 111, 83);
}

/* Reward Magnet Feedback FX */
.reward-magnet-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    z-index: 200;
}

.reward-magnet-icon {
    position: absolute;
    width: 36px;
    height: 36px;
    border-radius: 18px;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.9);
    color: rgb(20, 39, 67);
    background-color: rgb(255, 202, 84);
}

.reward-magnet-icon--silver {
    background-color: rgb(194, 208, 226);
    border-color: rgb(240, 246, 255);
    color: rgb(20, 39, 67);
}

.reward-magnet-icon--gold {
    background-color: rgb(255, 198, 65);
    border-color: rgb(255, 240, 180);
    color: rgb(20, 39, 67);
}

.reward-magnet-icon--diamond {
    background-color: rgb(105, 223, 242);
    border-color: rgb(215, 250, 255);
    color: rgb(20, 39, 67);
}

.reward-magnet-icon--coin {
    background-color: rgb(255, 202, 84);
    border-color: rgb(255, 245, 200);
    color: rgb(140, 85, 10);
}

