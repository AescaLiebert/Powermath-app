    --figma-gradient-stop-2: 1;
    --figma-gradient-start-x: 0.5;
    --figma-gradient-start-y: 1.57708;
    --figma-gradient-end-x: 0.5;
    --figma-gradient-end-y: -0.4310341;
    background-color: rgb(0, 0, 0);
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

