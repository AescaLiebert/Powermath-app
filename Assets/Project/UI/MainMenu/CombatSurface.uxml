<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="NavigatorPanel" src="project://database/Assets/Project/UI/MainMenu/NavigatorPanel.uxml?fileID=9197481963319205126&amp;guid=06cb78a1b6c61b949ac197f1543ab3d8&amp;type=3#NavigatorPanel"/>
    <Style src="project://database/Assets/Project/UI/Theme/MathWorldControls.uss?fileID=7433441132597879392&amp;guid=0a8215442f910a4479ac54be6c38cc6c&amp;type=3#MathWorldControls"/>
    <Style src="project://database/Assets/Project/UI/Theme/MathWorldStates.uss?fileID=7433441132597879392&amp;guid=8aad1a0913b7bf744b3c0e064a10988e&amp;type=3#MathWorldStates"/>
    <Style src="project://database/Assets/Project/UI/Theme/MathWorldTypography.uss?fileID=7433441132597879392&amp;guid=a48c50e68101bf04b958cd4ba35225fa&amp;type=3#MathWorldTypography"/>
    <ui:VisualElement name="combat-layer" enabled="true" picking-mode="Ignore" class="combat-layer is-hidden">
        <ui:VisualElement name="combat-enemy-card" class="hud-encounter-panel">
            <ui:Label name="combat-stage-label" text="STAGE 1" class="hud-stage-label"/>
            <ui:VisualElement name="combat-enemy-hp-shell" picking-mode="Ignore" class="hud-enemy-hp-shell">
                <ui:ProgressBar name="combat-enemy-hp" value="0" high-value="100" class="hud-enemy-hp"/>
                <ui:VisualElement class="hud-enemy-hp-overlay">
                    <ui:Label name="combat-enemy-name" text="Preparing encounter..." class="hud-enemy-name"/>
                    <ui:Label name="combat-enemy-hp-label" text="— / — HP" class="hud-enemy-hp-label"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="combat-enemy-actions" picking-mode="Ignore" class="hud-enemy-actions"/>
        </ui:VisualElement>
        <ui:Button name="combat-attack-button" text="⚔" tooltip="Attack" class="hud-attack-button"/>
        <ui:VisualElement name="player-dashboard" class="hud-dashboard">
            <ui:VisualElement class="hud-health-row">
                <ui:Label text="♥" class="hud-health-icon"/>
                <ui:Label name="combat-hearts-label" text="♡ ♡ ♡" class="hud-health-value"/>
            </ui:VisualElement>
            <ui:VisualElement class="hud-dashboard-slots">
                <ui:VisualElement tooltip="Current Rank" class="hud-dashboard-slot hud-dashboard-slot--rank">
                    <ui:Label name="academic-rank-label" text="RANK SILVER"/>
                    <ui:Label name="academic-rank-multiplier" text="Damage ×1.0" class="hud-compat-hidden"/>
                    <ui:Label name="academic-active-currency" text="Silver: 0" class="hud-compat-hidden"/>
                </ui:VisualElement>
                <ui:VisualElement tooltip="Equipped Pet" class="hud-dashboard-slot">
                    <ui:Label text="PET" class="hud-slot-caption"/>
                    <ui:Label name="dashboard-pet" text="NONE" class="hud-slot-value"/>
                </ui:VisualElement>
                <ui:VisualElement tooltip="Equipped Weapon" class="hud-dashboard-slot">
                    <ui:Label text="WEAPON" class="hud-slot-caption"/>
                    <ui:Label name="dashboard-weapon" text="NONE" class="hud-slot-value"/>
                </ui:VisualElement>
                <ui:VisualElement tooltip="Power-up cards are not implemented yet" enabled="false" class="hud-dashboard-slot hud-dashboard-slot--locked">
                    <ui:Label text="CARD" class="hud-slot-caption"/>
                    <ui:Label text="—" class="hud-slot-value"/>
                </ui:VisualElement>
                <ui:VisualElement tooltip="Power-up cards are not implemented yet" enabled="false" class="hud-dashboard-slot hud-dashboard-slot--locked">
                    <ui:Label text="CARD" class="hud-slot-caption"/>
                    <ui:Label text="—" class="hud-slot-value"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="combat-biome-label" text="PREPARING BIOME" class="hud-compat-hidden"/>
        <ui:Label name="combat-simulation-badge" text="SIMULATION — NOT SAVED" class="combat-simulation-badge is-hidden"/>
        <ui:Label name="academic-local-badge" text="LOCAL PROGRESSION — NOT SAVED" class="academic-local-badge is-hidden"/>
        <ui:Label name="combat-damage-label" text="" class="combat-damage-label"/>
        <ui:Label name="combat-critical-label" text="CRITICAL" class="combat-critical-label is-hidden"/>
        <ui:VisualElement name="combat-attempt-panel" focusable="true" class="mw-card combat-attempt-panel is-hidden">
            <ui:Label text="MATH CHALLENGE" class="combat-attempt-title"/>
            <ui:Label name="academic-question-meta" text="silver-001 • Silver" class="academic-question-meta"/>
            <ui:Label name="academic-question-prompt" text="QA target answer: 7" class="academic-question-prompt"/>
            <ui:Label name="combat-timer-label" text="10" class="combat-timer"/>
            <ui:Label name="combat-timer-caption" text="GET READY" class="combat-timer-caption"/>
            <ui:Label name="combat-answer-display" text="Enter your answer" class="combat-answer-display combat-answer--placeholder"/>
            <ui:VisualElement class="combat-numpad">
                <ui:Button name="combat-digit-1" text="1" class="combat-key"/>
                <ui:Button name="combat-digit-2" text="2" class="combat-key"/>
                <ui:Button name="combat-digit-3" text="3" class="combat-key"/>
                <ui:Button name="combat-digit-4" text="4" class="combat-key"/>
                <ui:Button name="combat-digit-5" text="5" class="combat-key"/>
                <ui:Button name="combat-digit-6" text="6" class="combat-key"/>
                <ui:Button name="combat-digit-7" text="7" class="combat-key"/>
                <ui:Button name="combat-digit-8" text="8" class="combat-key"/>
                <ui:Button name="combat-digit-9" text="9" class="combat-key"/>
                <ui:Button name="combat-digit-0" text="0" class="combat-key"/>
                <ui:Button name="combat-backspace-button" text="BACKSPACE" class="combat-key combat-key--utility"/>
                <ui:Button name="combat-clear-button" text="CLEAR" class="combat-key combat-key--utility"/>
                <ui:Button name="combat-submit-button" text="SUBMIT" class="combat-key combat-key--submit"/>
            </ui:VisualElement>
            <ui:Label name="combat-result-label" text="" class="combat-result"/>
            <ui:Label name="academic-currency-gain" text="" class="academic-currency-gain"/>
        </ui:VisualElement>
        <ui:VisualElement name="academic-rank-modal" class="academic-rank-modal">
            <ui:VisualElement class="academic-rank-modal-card">
                <ui:Label name="academic-rank-modal-header" text="RANK UP" class="academic-rank-modal-header"/>
                <ui:Label name="academic-rank-modal-route" text="Silver  →  Gold" class="academic-rank-modal-route"/>
                <ui:Label name="academic-rank-modal-body" text="Your next questions will match your new Rank." class="academic-rank-modal-body"/>
                <ui:Label name="academic-rank-modal-multiplier" text="New damage multiplier: ×1.5" class="academic-rank-modal-multiplier"/>
                <ui:Button name="academic-rank-continue-button" text="CONTINUE" class="academic-rank-continue-button"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="combat-biome-transition" class="combat-biome-transition">
            <ui:Label name="combat-biome-transition-kicker" text="ENTERING" class="combat-biome-transition-kicker"/>
            <ui:Label name="combat-biome-transition-title" text="BIOME" class="combat-biome-transition-title"/>
        </ui:VisualElement>
        <ui:Instance template="NavigatorPanel" picking-mode="Ignore" class="mw-template-fill"/>
    </ui:VisualElement>
</ui:UXML>
