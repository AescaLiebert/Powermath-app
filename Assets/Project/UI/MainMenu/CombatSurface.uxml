<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xmlns:pm="PowerMath.UI.Core" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="NavigatorPanel" src="project://database/Assets/Project/UI/MainMenu/NavigatorPanel.uxml?fileID=9197481963319205126&amp;guid=06cb78a1b6c61b949ac197f1543ab3d8&amp;type=3#NavigatorPanel"/>
    <Style src="project://database/Assets/Project/UI/Theme/MathWorldControls.uss?fileID=7433441132597879392&amp;guid=0a8215442f910a4479ac54be6c38cc6c&amp;type=3#MathWorldControls"/>
    <Style src="project://database/Assets/Project/UI/Theme/MathWorldStates.uss?fileID=7433441132597879392&amp;guid=8aad1a0913b7bf744b3c0e064a10988e&amp;type=3#MathWorldStates"/>
    <Style src="project://database/Assets/Project/UI/Theme/MathWorldTypography.uss?fileID=7433441132597879392&amp;guid=a48c50e68101bf04b958cd4ba35225fa&amp;type=3#MathWorldTypography"/>
    <ui:VisualElement name="combat-layer" enabled="true" picking-mode="Ignore" class="combat-layer is-hidden">
        <ui:VisualElement name="combat-enemy-card" class="hud-encounter-panel main-menu-transition-top">
            <ui:Label name="combat-stage-label-compat" text="STAGE 1" class="hud-stage-label"/>
            <ui:VisualElement name="combat-enemy-hp-shell" picking-mode="Ignore" class="hud-enemy-hp-shell">
                <ui:ProgressBar name="combat-enemy-hp-compat" value="0" high-value="100" class="hud-enemy-hp"/>
                <ui:VisualElement class="hud-enemy-hp-overlay">
                    <ui:Label name="combat-enemy-name-compat" text="Preparing encounter..." class="hud-enemy-name"/>
                    <ui:Label name="combat-enemy-hp-label-compat" text="— / — HP" class="hud-enemy-hp-label"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="combat-enemy-actions-compat" picking-mode="Ignore" class="hud-enemy-actions"/>
        </ui:VisualElement>
        <ui:VisualElement name="Player Loadout" class="hud-dashboard main-menu-transition-dashboard">
            <pm:FigmaShadowElement name="Player Loadout Shadow" class="hud-loadout-panel-shadow"/>
            <ui:VisualElement name="Round_Panel_outer" picking-mode="Ignore" class="hud-loadout-panel-outer">
                <pm:FigmaShadowElement name="Round_Panel_outer Shadow" class="hud-loadout-outer-shadow"/>
                <pm:FigmaShadowElement name="Panel_Inner Shadow" class="hud-loadout-inner-shadow"/>
                <ui:VisualElement name="Panel_Inner" picking-mode="Ignore" class="hud-loadout-panel-inner"/>
            </ui:VisualElement>
            <ui:VisualElement name="Player Loadout / Health Row" picking-mode="Ignore" class="hud-loadout-health-row">
                <ui:Label name="CharacterName" text="Stellar" picking-mode="Ignore" class="hud-loadout-character-name"/>
                <ui:VisualElement name="Health" picking-mode="Ignore" class="hud-loadout-health">
                    <ui:VisualElement name="heart" picking-mode="Ignore" class="hud-loadout-heart"/>
                    <ui:VisualElement name="heart" picking-mode="Ignore" class="hud-loadout-heart"/>
                    <ui:VisualElement name="heart" picking-mode="Ignore" class="hud-loadout-heart"/>
                    <ui:VisualElement name="heart" picking-mode="Ignore" class="hud-loadout-heart"/>
                    <ui:VisualElement name="heart" picking-mode="Ignore" class="hud-loadout-heart hud-loadout-heart--last"/>
                </ui:VisualElement>
                <ui:Label name="combat-hearts-label" text="♥ ♥ ♥ ♥ ♥" picking-mode="Ignore" class="hud-compat-hidden"/>
            </ui:VisualElement>
            <ui:VisualElement name="Player Loadout / Inventory Row" class="hud-loadout-inventory-row">
                <ui:VisualElement name="Quick Slot / Pet" tooltip="Equipped Pet" class="hud-loadout-slot hud-loadout-slot--large">
                    <pm:FigmaShadowElement name="Quick Slot / Pet Shadow" class="hud-loadout-slot-shadow hud-loadout-slot-shadow--large"/>
                    <pm:FigmaGradientElement name="Quick Slot / Pet Gradient" class="hud-loadout-slot-gradient"/>
                    <ui:VisualElement name="border" picking-mode="Ignore" class="hud-loadout-slot-border hud-loadout-slot-border--large"/>
                    <ui:VisualElement name="Quick Slot / Pet Artwork" picking-mode="Ignore" class="hud-loadout-artwork hud-loadout-artwork--large">
                        <ui:VisualElement name="Vector / Quick Slot / Pet Artwork Watermark" picking-mode="Ignore" class="hud-loadout-watermark hud-loadout-watermark--pet"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="star-frame" picking-mode="Ignore" class="hud-loadout-star-frame">
                        <ui:VisualElement name="star" picking-mode="Ignore" class="hud-loadout-star"/>
                    </ui:VisualElement>
                    <ui:Label name="dashboard-pet" text="NONE" picking-mode="Ignore" class="hud-compat-hidden"/>
                </ui:VisualElement>
                <ui:VisualElement name="Quick Slot / Weapon" tooltip="Equipped Weapon" class="hud-loadout-slot hud-loadout-slot--large">
                    <pm:FigmaShadowElement name="Quick Slot / Weapon Shadow" class="hud-loadout-slot-shadow hud-loadout-slot-shadow--large"/>
                    <pm:FigmaGradientElement name="Quick Slot / Weapon Gradient" class="hud-loadout-slot-gradient"/>
                    <ui:VisualElement name="border" picking-mode="Ignore" class="hud-loadout-slot-border hud-loadout-slot-border--large hud-loadout-slot-border--weapon"/>
                    <ui:VisualElement name="Quick Slot / Pet Artwork" picking-mode="Ignore" class="hud-loadout-artwork hud-loadout-artwork--large">
                        <ui:VisualElement name="Vector / Quick Slot / Pet Artwork Watermark" picking-mode="Ignore" class="hud-loadout-watermark hud-loadout-watermark--weapon"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="star-frame" picking-mode="Ignore" class="hud-loadout-star-frame">
                        <ui:VisualElement name="star" picking-mode="Ignore" class="hud-loadout-star"/>
                    </ui:VisualElement>
                    <ui:Label name="dashboard-weapon" text="NONE" picking-mode="Ignore" class="hud-compat-hidden"/>
                </ui:VisualElement>
                <ui:VisualElement name="Quick Slot / Not Empty" class="hud-loadout-slot hud-loadout-slot--small">
                    <pm:FigmaShadowElement name="Quick Slot / Not Empty Shadow" class="hud-loadout-slot-shadow hud-loadout-slot-shadow--small"/>
                    <pm:FigmaGradientElement name="Quick Slot / Not Empty Gradient" class="hud-loadout-slot-gradient"/>
                    <ui:VisualElement name="border" picking-mode="Ignore" class="hud-loadout-slot-border hud-loadout-slot-border--small"/>
                </ui:VisualElement>
                <ui:VisualElement name="Quick Slot / Not Empty" class="hud-loadout-slot hud-loadout-slot--small">
                    <pm:FigmaShadowElement name="Quick Slot / Not Empty Shadow" class="hud-loadout-slot-shadow hud-loadout-slot-shadow--small"/>
                    <pm:FigmaGradientElement name="Quick Slot / Not Empty Gradient" class="hud-loadout-slot-gradient"/>
                    <ui:VisualElement name="border" picking-mode="Ignore" class="hud-loadout-slot-border hud-loadout-slot-border--small"/>
                </ui:VisualElement>
                <ui:VisualElement name="Quick Slot / Empty 1" tooltip="Slot unavailable" class="hud-loadout-slot hud-loadout-slot--small hud-loadout-slot--last">
                    <pm:FigmaShadowElement name="Quick Slot / Empty 1 Shadow" class="hud-loadout-slot-shadow hud-loadout-slot-shadow--small"/>
                    <pm:FigmaGradientElement name="Quick Slot / Empty 1 Gradient" class="hud-loadout-slot-gradient"/>
                    <ui:VisualElement name="border" picking-mode="Ignore" class="hud-loadout-slot-border hud-loadout-slot-border--small"/>
                    <ui:VisualElement name="UnavailablePanel" picking-mode="Ignore" class="hud-loadout-unavailable"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="academic-rank-label" text="RANK SILVER" picking-mode="Ignore" class="hud-compat-hidden"/>
            <ui:Label name="academic-rank-multiplier" text="Damage ×1.0" picking-mode="Ignore" class="hud-compat-hidden"/>
            <ui:Label name="academic-active-currency" text="Silver: 0" picking-mode="Ignore" class="hud-compat-hidden"/>
        </ui:VisualElement>
        <ui:Label name="combat-biome-label" text="PREPARING BIOME" picking-mode="Ignore" class="hud-compat-hidden"/>
        <ui:Label name="combat-damage-label" text="" picking-mode="Ignore" class="combat-damage-label"/>
        <ui:Label name="combat-critical-label" text="CRITICAL" picking-mode="Ignore" class="combat-critical-label is-hidden"/>
        <ui:Label name="combat-battle-banner" text="" picking-mode="Ignore" class="combat-battle-banner is-hidden"/>
        <ui:VisualElement name="combat-attempt-panel" focusable="true" class="mw-card combat-attempt-panel is-hidden">
            <ui:Label text="MATH CHALLENGE" class="combat-attempt-title"/>
            <ui:VisualElement name="combat-answer-content" class="combat-answer-content">
                <ui:Label name="academic-question-meta" text="silver-001 • Silver" class="academic-question-meta"/>
                <ui:Label name="academic-question-prompt" text="QA target answer: 7" class="academic-question-prompt"/>
                <ui:Label name="combat-timer-label" text="10" class="combat-timer"/>
                <ui:Label name="combat-timer-caption" text="GET READY" class="combat-timer-caption"/>
                <ui:Label name="combat-answer-display" text="Enter your answer" class="combat-answer-display combat-answer--placeholder"/>
                <ui:VisualElement class="combat-numpad">
                    <ui:Button name="combat-digit-1" text="1" class="combat-key"/>
                    <ui:Button name="combat-digit-2" text="2" class="combat-key"/>
                    <ui:Button name="combat-digit-3" text="3" class="combat-key"/>
                    <ui:Button name="combat-digit-4" text="4" class="combat-key"/>
                    <ui:Button name="combat-digit-5" text="5" class="combat-key"/>
                    <ui:Button name="combat-digit-6" text="6" class="combat-key"/>
                    <ui:Button name="combat-digit-7" text="7" class="combat-key"/>
                    <ui:Button name="combat-digit-8" text="8" class="combat-key"/>
                    <ui:Button name="combat-digit-9" text="9" class="combat-key"/>
                    <ui:Button name="combat-digit-0" text="0" class="combat-key"/>
                    <ui:Button name="combat-backspace-button" text="BACKSPACE" class="combat-key combat-key--utility"/>
                    <ui:Button name="combat-clear-button" text="CLEAR" class="combat-key combat-key--utility"/>
                    <ui:Button name="combat-submit-button" text="SUBMIT" class="combat-key combat-key--submit"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="combat-feedback-card" class="combat-feedback-card is-hidden">
                <ui:Label name="combat-feedback-icon" text="✓" class="combat-feedback-icon"/>
                <ui:Label name="combat-feedback-title" text="CORRECT" class="combat-feedback-title"/>
                <ui:Label name="combat-feedback-subtitle" text="Building your attack" class="combat-feedback-subtitle"/>
                <ui:VisualElement name="combat-score-stack" class="combat-score-stack"/>
            </ui:VisualElement>
            <ui:Label name="combat-result-label" text="" class="combat-result"/>
            <ui:Label name="academic-currency-gain" text="" class="academic-currency-gain"/>
        </ui:VisualElement>
        <ui:VisualElement name="combat-biome-transition" picking-mode="Ignore" class="combat-biome-transition is-hidden">
            <ui:VisualElement name="combat-biome-transition-backdrop" picking-mode="Ignore" class="combat-biome-transition-backdrop"/>
            <ui:VisualElement name="combat-biome-transition-card" picking-mode="Ignore" class="combat-biome-transition-card">
                <ui:Label name="combat-biome-transition-kicker" text="ENTERING NEW BIOME" picking-mode="Ignore" class="combat-biome-transition-kicker"/>
                <ui:Label name="combat-biome-transition-title" text="BIOME" picking-mode="Ignore" class="combat-biome-transition-title"/>
                <ui:VisualElement name="combat-biome-transition-accent" picking-mode="Ignore" class="combat-biome-transition-accent"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Instance template="NavigatorPanel" picking-mode="Ignore" class="mw-template-fill"/>
        <ui:VisualElement name="main-menu-interaction-shield" focusable="true" class="main-menu-interaction-shield is-hidden"/>
        <ui:VisualElement name="academic-rank-modal" picking-mode="Position" class="academic-rank-modal">
            <ui:VisualElement name="academic-rank-aura" picking-mode="Ignore" class="academic-rank-aura"/>
            <ui:VisualElement name="academic-rank-notification" picking-mode="Ignore" class="academic-rank-notification">
                <ui:VisualElement name="academic-rank-banner" picking-mode="Ignore" class="academic-rank-banner">
                    <ui:VisualElement name="academic-rank-banner-glow" picking-mode="Ignore" class="academic-rank-banner-glow"/>
                    <ui:Label name="academic-rank-modal-header" text="RANK UP" picking-mode="Ignore" class="academic-rank-modal-header"/>
                </ui:VisualElement>
                <ui:VisualElement name="academic-rank-route-container" picking-mode="Ignore" class="academic-rank-route-container">
                    <ui:VisualElement name="academic-rank-route-badges" picking-mode="Ignore" class="academic-rank-route-badges">
                        <ui:VisualElement name="academic-rank-badge-prev" picking-mode="Ignore" class="academic-rank-badge academic-rank-badge--silver">
                            <ui:Label name="academic-rank-icon-prev" text="S" picking-mode="Ignore" class="hud-rank-icon hud-rank-icon--silver academic-rank-badge-icon"/>
                            <ui:Label name="academic-rank-name-prev" text="SILVER" picking-mode="Ignore" class="academic-rank-badge-name"/>
                        </ui:VisualElement>
                        <ui:Label name="academic-rank-arrow" text="➔" picking-mode="Ignore" class="academic-rank-arrow"/>
                        <ui:VisualElement name="academic-rank-badge-curr" picking-mode="Ignore" class="academic-rank-badge academic-rank-badge--gold">
                            <ui:Label name="academic-rank-icon-curr" text="G" picking-mode="Ignore" class="hud-rank-icon hud-rank-icon--gold academic-rank-badge-icon"/>
                            <ui:Label name="academic-rank-name-curr" text="GOLD" picking-mode="Ignore" class="academic-rank-badge-name"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label name="academic-rank-modal-route" text="Silver  →  Gold" picking-mode="Ignore" class="academic-rank-modal-route hud-compat-hidden"/>
                    <ui:Label name="academic-rank-modal-body" text="" picking-mode="Ignore" class="hud-compat-hidden"/>
                    <ui:Label name="academic-rank-modal-multiplier" text="" picking-mode="Ignore" class="hud-compat-hidden"/>
                    <ui:Label name="academic-rank-tap-prompt" text="TAP ANYWHERE TO CONTINUE" picking-mode="Ignore" class="academic-rank-tap-prompt"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="academic-rank-continue-button" focusable="true" picking-mode="Position" class="academic-rank-continue-button academic-rank-touch-surface"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
