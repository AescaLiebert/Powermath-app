<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="combat-map-modal" focusable="true" class="combat-map-modal navigator-modal is-hidden">
        <ui:VisualElement class="navigator-backdrop-disc" picking-mode="Ignore"/>
        <ui:VisualElement class="mw-card combat-map-card navigator-card">
            <ui:VisualElement class="navigator-header">
                <ui:VisualElement>
                    <ui:Label text="NAVIGATOR" class="loc-menu.navigator mw-kicker navigator-kicker"/>
                    <ui:Label text="WORLD JOURNEY" class="loc-menu.world combat-map-title navigator-title"/>
                    <ui:Label text="Your marker shows the current biome. This map is informational." class="loc-menu.routeHelp combat-map-subtitle navigator-subtitle"/>
                </ui:VisualElement>
                <ui:VisualElement class="navigator-header-controls">
                    <ui:VisualElement class="navigator-balance-pill">
                        <ui:VisualElement class="navigator-coin-icon" picking-mode="Ignore"/>
                        <ui:Label name="combat-map-balance" text="0" class="navigator-balance"/>
                    </ui:VisualElement>
                    <ui:Button name="combat-map-close" text="×" tooltip="Close Map" class="combat-map-close navigator-close"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="navigator-legend">
                <ui:VisualElement class="navigator-current-dot"/>
                <ui:Label class="loc-menu.currentBiome" text="CURRENT BIOME"/>
                <ui:Label text="ROUTE PREVIEW — NO FAST TRAVEL" class="loc-menu.route navigator-readonly"/>
            </ui:VisualElement>
            <ui:ScrollView class="navigator-scroll">
                <ui:VisualElement name="combat-map-route" class="combat-map-route navigator-route">
                    <ui:Label text="Preparing your saved route..." class="navigator-empty"/>
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
